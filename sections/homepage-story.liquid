{%- assign demo_images = 'demo-mission-1.jpg,demo-mission-2.jpg,demo-panel-running.jpg,demo-mission-3.jpg' | split: ',' -%}
{%- assign state_count = section.blocks.size -%}
<section class="mstory{% if section.settings.font_style == 'display' %} mstory--display{% endif %}" id="our-mission" data-story data-hold="{{ section.settings.hold }}" style="--n: {{ state_count }}; --step: {{ section.settings.scroll_length }}; --hold: {{ section.settings.hold }};">
  <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
  <div class="mstory__stage">
    {%- for block in section.blocks -%}
      {%- liquid
        assign state_src = nil
        if block.settings.solid != true
          if block.settings.image != blank
            assign state_src = block.settings.image | image_url: width: 2000
          elsif settings.show_demo_images
            assign demo_idx = forloop.index0 | modulo: 4
            assign state_src = demo_images[demo_idx] | asset_url
          endif
        endif
      -%}
      <div class="mstory__state{% if forloop.first %} is-active{% endif %}" data-story-state style="--i: {{ forloop.index }}; --state-bg: {{ block.settings.bg_color }}; --state-fg: {{ block.settings.text_color }}; --state-overlay: {{ block.settings.overlay | divided_by: 100.0 }}; --state-gray: {% if block.settings.grayscale %}1{% else %}0{% endif %};" {{ block.shopify_attributes }}>
        {%- if state_src -%}
          <img class="mstory__img" src="{{ state_src }}" alt="" loading="lazy" width="1200" height="1600">
        {%- endif -%}
        <div class="mstory__inner page-width">
          <p class="eyebrow mstory__label"><span>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{% if block.settings.label != blank %} &mdash; {{ block.settings.label }}{% endif %}</p>
          <p class="mstory__text">{{ block.settings.text | newline_to_br }}</p>
          {%- if block.settings.body != blank -%}
            <p class="mstory__body">{{ block.settings.body | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: routes.root_url }}" class="btn btn--lg mstory__cta">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
    {%- if section.settings.show_progress and state_count > 1 -%}
      <ol class="mstory__dots" aria-hidden="true">
        {%- for block in section.blocks -%}<li data-story-dot{% if forloop.first %} class="is-active"{% endif %}></li>{%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Mission scroll story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (for screen readers)", "default": "Our mission" },
    { "type": "select", "id": "font_style", "label": "Type style", "default": "display", "options": [
      { "value": "display", "label": "Wide serif display" },
      { "value": "theme",   "label": "Theme heading font" }
    ] },
    { "type": "range", "id": "scroll_length", "label": "Scroll distance per slide", "info": "How far the visitor scrolls before the next slide appears. Higher is slower.", "min": 60, "max": 140, "step": 20, "unit": "vh", "default": 100 },
    { "type": "range", "id": "hold", "label": "Hold on the last slide", "info": "Extra scrolling spent on the final slide before the page carries on to the footer.", "min": 0, "max": 200, "step": 20, "unit": "vh", "default": 100 },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress dots", "default": true }
  ],
  "blocks": [
    {
      "type": "state",
      "name": "Slide",
      "limit": 8,
      "settings": [
        { "type": "header", "content": "Content" },
        { "type": "text",     "id": "label", "label": "Small label", "info": "Shown beside the slide number." },
        { "type": "textarea", "id": "text",  "label": "Headline", "default": "We don’t run because we have to." },
        { "type": "textarea", "id": "body",  "label": "Supporting text", "info": "Optional paragraph under the headline." },
        { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty for no button." },
        { "type": "url",  "id": "button_link",  "label": "Button link" },
        { "type": "header", "content": "Look" },
        { "type": "checkbox", "id": "solid", "label": "Solid colour (no photo)", "default": false },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait or landscape; it fills the screen." },
        { "type": "range", "id": "overlay", "label": "Photo darkening", "min": 0, "max": 80, "step": 10, "unit": "%", "default": 40 },
        { "type": "checkbox", "id": "grayscale", "label": "Black and white photo", "default": false },
        { "type": "color", "id": "bg_color",   "label": "Background colour", "default": "#0d0d0d" },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff" }
      ]
    }
  ],
  "presets": [
    { "name": "Mission scroll story", "blocks": [ { "type": "state" }, { "type": "state" }, { "type": "state" } ] }
  ]
}
{% endschema %}
