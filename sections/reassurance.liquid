{%- if section.blocks.size > 0 -%}
  <section class="reassurance">
    <div class="page-width">
      <div class="reassurance__grid">
        {%- for block in section.blocks -%}
          {%- assign link_url = block.settings.link -%}
          {%- if link_url == blank -%}
            {%- case block.settings.icon -%}
              {%- when 'delivery' -%}{%- assign link_url = shop.shipping_policy.url -%}
              {%- when 'returns' -%}{%- assign link_url = shop.refund_policy.url -%}
              {%- when 'help' -%}{%- if shop.email != blank -%}{%- assign link_url = 'mailto:' | append: shop.email -%}{%- endif -%}
            {%- endcase -%}
          {%- endif -%}
          <div class="reassurance__item" {{ block.shopify_attributes }}>
            <span class="reassurance__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                {%- case block.settings.icon -%}
                  {%- when 'help' -%}
                    <circle cx="12" cy="12" r="9"/><path d="M9.6 9.6a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1.1.9-1.1 1.7"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                  {%- when 'delivery' -%}
                    <path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5l9 4.5 9-4.5"/><path d="M12 12v9"/>
                  {%- when 'returns' -%}
                    <path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
                  {%- when 'secure' -%}
                    <rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                  {%- when 'quality' -%}
                    <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>
                {%- endcase -%}
              </svg>
            </span>
            <div class="reassurance__body">
              <h3 class="reassurance__title">{{ block.settings.heading }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="reassurance__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank and link_url != blank -%}
                <a href="{{ link_url }}" class="reassurance__link">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reassurance",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Reassurance item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "help",     "label": "Help (question mark)" },
            { "value": "delivery", "label": "Delivery (box)" },
            { "value": "returns",  "label": "Returns (arrow)" },
            { "value": "secure",   "label": "Secure (padlock)" },
            { "value": "quality",  "label": "Quality (shield)" }
          ],
          "default": "help"
        },
        { "type": "text",     "id": "heading",    "label": "Heading", "default": "Get help buying" },
        { "type": "textarea", "id": "text",       "label": "Text", "default": "If you have any questions about our gear, get in touch." },
        { "type": "text",     "id": "link_label", "label": "Link label", "default": "Contact us" },
        { "type": "url",      "id": "link",       "label": "Link", "info": "Optional. Leave empty to use a sensible default: Delivery links to your shipping policy, Returns to your refund policy, Help to your store email." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "help", "heading": "Get help buying", "text": "If you have any questions about our gear, get in touch.", "link_label": "Contact us" } },
      { "type": "item", "settings": { "icon": "delivery", "heading": "Free UK delivery", "text": "Orders over £75 ship free within the UK.", "link_label": "Learn more" } },
      { "type": "item", "settings": { "icon": "returns", "heading": "Free & easy returns", "text": "Returns are accepted within 30 days. Run in them, then decide.", "link_label": "Learn more" } }
    ]
  }
}
{% endschema %}
