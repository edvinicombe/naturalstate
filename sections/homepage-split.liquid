<section class="split">
  {%- for i in (1..2) -%}
    {%- liquid
      if i == 1
        assign panel_image = section.settings.panel_1_image
        assign panel_title = section.settings.panel_1_title
        assign panel_link = section.settings.panel_1_link
      else
        assign panel_image = section.settings.panel_2_image
        assign panel_title = section.settings.panel_2_title
        assign panel_link = section.settings.panel_2_link
      endif
    -%}
    {%- if panel_title != blank or panel_image != blank -%}
      <a class="split__panel" href="{{ panel_link | default: routes.all_products_collection_url }}">
        {%- if panel_image != blank -%}
          <img class="split__img" src="{{ panel_image | image_url: width: 1600 }}" alt="" loading="lazy" width="1600" height="1600">
        {%- endif -%}
        <span class="split__label">
          <span class="split__title">{{ panel_title }}</span>
          <span class="split__arrow" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" focusable="false"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
          </span>
        </span>
      </a>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Category panels",
  "settings": [
    { "type": "header", "content": "Left panel" },
    { "type": "image_picker", "id": "panel_1_image", "label": "Image", "info": "Square or portrait works best." },
    { "type": "text", "id": "panel_1_title", "label": "Name", "default": "Running" },
    { "type": "url",  "id": "panel_1_link",  "label": "Link" },
    { "type": "header", "content": "Right panel" },
    { "type": "image_picker", "id": "panel_2_image", "label": "Image", "info": "Square or portrait works best." },
    { "type": "text", "id": "panel_2_title", "label": "Name", "default": "Lifestyle" },
    { "type": "url",  "id": "panel_2_link",  "label": "Link" }
  ],
  "presets": [{ "name": "Category panels" }]
}
{% endschema %}
