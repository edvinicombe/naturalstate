<section class="hero">
  {%- if section.settings.hero_image -%}
    <img class="hero__bg" src="{{ section.settings.hero_image | image_url: width: 2400 }}" alt="" loading="eager" width="2400" height="1600">
  {%- endif -%}
  <div class="hero__content page-width">
    {%- if section.settings.hero_eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
    {%- endif -%}
    <h1 class="h1">{{ section.settings.hero_heading }}</h1>
    <div class="hero__actions">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: routes.all_products_collection_url }}" class="btn btn--lg btn--light">{{ section.settings.btn_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: routes.all_products_collection_url }}" class="btn btn--lg btn--light">{{ section.settings.btn_2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image",   "label": "Background image" },
    { "type": "text",         "id": "hero_eyebrow", "label": "Eyebrow",  "default": "New Season" },
    { "type": "text",         "id": "hero_heading", "label": "Heading",  "default": "Engineered for the long run" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn_1_label", "label": "First button label", "default": "Shop mens" },
    { "type": "url",  "id": "btn_1_link",  "label": "First button link" },
    { "type": "text", "id": "btn_2_label", "label": "Second button label", "default": "Shop womens" },
    { "type": "url",  "id": "btn_2_link",  "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
