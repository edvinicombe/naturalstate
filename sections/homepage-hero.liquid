{%- liquid
  assign hero_video = section.settings.hero_video
  assign use_demo = false
  if hero_video == blank and section.settings.show_demo_video
    assign use_demo = true
  endif
  if use_demo
    assign hero_poster = 'hero-video-poster.jpg' | asset_url
  elsif section.settings.hero_image != blank
    assign hero_poster = section.settings.hero_image | image_url: width: 1600
  elsif hero_video != blank
    assign hero_poster = hero_video.preview_image | image_url: width: 1600
  endif
-%}
<section class="hero{% if hero_video != blank or use_demo %} hero--video{% endif %}{% if section.settings.header_style == 'light' %} hero--header-light{% endif %}">
  {%- if hero_video != blank or use_demo -%}
    <video class="hero__bg hero__video" autoplay muted loop playsinline preload="auto"{% if hero_poster != blank %} poster="{{ hero_poster }}"{% endif %} aria-hidden="true" data-hero-video>
      {%- if hero_video != blank -%}
        {%- for source in hero_video.sources -%}
          {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <source src="{{ 'hero-video.mp4' | asset_url }}" type="video/mp4">
      {%- endif -%}
    </video>
    <button type="button" class="hero__toggle" data-hero-video-toggle aria-label="Pause background video" aria-pressed="false">
      <svg class="hero__toggle-pause" width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M520-200v-560h240v560H520Zm-320 0v-560h240v560H200Zm400-80h80v-400h-80v400Zm-320 0h80v-400h-80v400Zm0-400v400-400Zm320 0v400-400Z"/></svg>
      <svg class="hero__toggle-play" width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M320-200v-560l440 280-440 280Zm80-280Zm0 134 210-134-210-134v268Z"/></svg>
    </button>
  {%- elsif section.settings.hero_image != blank -%}
    <img class="hero__bg" src="{{ section.settings.hero_image | image_url: width: 2400 }}" alt="" loading="eager" width="2400" height="1600">
  {%- endif -%}
  <div class="hero__content page-width">
    {%- if section.settings.heading_image != blank -%}
      <h1 class="hero__logo-heading">
        <img class="hero__logo" src="{{ section.settings.heading_image | image_url: width: 1600 }}" alt="{{ section.settings.heading_alt | default: shop.name | escape }}" width="{{ section.settings.heading_image.width }}" height="{{ section.settings.heading_image.height }}" style="--hero-logo-w: {{ section.settings.logo_width }}rem;">
      </h1>
    {%- elsif section.settings.use_default_logo -%}
      <h1 class="hero__logo-heading">
        <img class="hero__logo" src="{{ 'motto-feel-the-run-white.svg' | asset_url }}" alt="{{ section.settings.heading_alt | default: 'Feel The Run' | escape }}" width="966" height="960" style="--hero-logo-w: {{ section.settings.logo_width }}rem;">
      </h1>
    {%- else -%}
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      <h1 class="h1">{{ section.settings.hero_heading }}</h1>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="hero__actions">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="btn btn--lg {% if block.settings.style == 'outline' %}btn--outline-light{% else %}btn--light{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "hero_image",   "label": "Background image", "info": "Also shown while a video loads, and for visitors who prefer reduced motion." },
    { "type": "video",        "id": "hero_video",   "label": "Background video", "info": "Optional. Upload an MP4 under Content > Files, then pick it here. Plays muted on a loop, behind the heading." },
    { "type": "checkbox",     "id": "show_demo_video", "label": "Show the built-in Feel The Run film", "info": "A 21-second loop cut from the brand photography. Used only until you pick your own video above. Untick to use the background image alone.", "default": true },
    { "type": "select", "id": "header_style", "label": "Header text over the hero", "info": "Use light for dark footage or photos, dark for bright ones.", "default": "light", "options": [
      { "value": "light", "label": "Light (white)" },
      { "value": "dark",  "label": "Dark (black)" }
    ] },
    { "type": "header", "content": "Heading" },
    { "type": "image_picker", "id": "heading_image", "label": "Heading image", "info": "Upload a logo or wordmark to show instead of the text heading. A PNG or SVG with a transparent background works best." },
    { "type": "checkbox",     "id": "use_default_logo", "label": "Use the white Feel The Run logo", "info": "Shown when no heading image is uploaded. Untick to use the text heading below instead.", "default": true },
    { "type": "range",        "id": "logo_width", "label": "Heading image width", "min": 12, "max": 40, "step": 2, "unit": "rem", "default": 28 },
    { "type": "text",         "id": "heading_alt", "label": "Heading image description", "info": "Read by screen readers and search engines.", "default": "Feel The Run" },
    { "type": "text",         "id": "hero_eyebrow", "label": "Eyebrow (text heading only)", "default": "New Season" },
    { "type": "text",         "id": "hero_heading", "label": "Text heading (when no image or logo)",  "default": "Engineered for the long run" }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "Button",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the collection" },
        { "type": "url",  "id": "link",  "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "default": "solid", "options": [
          { "value": "solid",   "label": "Solid white" },
          { "value": "outline", "label": "Outline" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "cta" }] }]
}
{% endschema %}
