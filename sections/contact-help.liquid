{%- comment -%}
  Help hub: intro + search, topic tiles and the FAQ. Each "Question" block has a topic;
  topics become the tiles (in the order they first appear) and the FAQ is grouped by them.
{%- endcomment -%}
{%- assign topics = '' | split: ',' -%}
{%- for block in section.blocks -%}
  {%- assign t = block.settings.topic | strip -%}
  {%- if t == blank -%}{%- assign t = 'General' -%}{%- endif -%}
  {%- unless topics contains t -%}
    {%- assign one = t | split: '|||' -%}
    {%- assign topics = topics | concat: one -%}
  {%- endunless -%}
{%- endfor -%}

<section class="help" data-faq>
  <div class="help__hero">
    <div class="page-width help__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="h1 help__title">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="help__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.settings.show_search and section.blocks.size > 0 -%}
        <form class="help__search" role="search" onsubmit="return false">
          <label for="HelpSearch" class="visually-hidden">Search our FAQs</label>
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>
          <input type="search" id="HelpSearch" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" data-faq-search>
        </form>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="page-width help__body">
      {%- if topics.size > 1 -%}
        <nav class="help__topics" aria-label="Help topics">
          <button type="button" class="help__topic is-active" data-faq-topic="" aria-pressed="true">
            <span class="help__topic-name">All topics</span>
            <span class="help__topic-count">{{ section.blocks.size }}</span>
          </button>
          {%- for topic in topics -%}
            {%- assign topic_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign bt = block.settings.topic | strip | default: 'General' -%}
              {%- if bt == topic -%}{%- assign topic_count = topic_count | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <button type="button" class="help__topic" data-faq-topic="{{ topic | handleize }}" aria-pressed="false">
              <span class="help__topic-name">{{ topic }}</span>
              <span class="help__topic-count">{{ topic_count }}</span>
            </button>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="help__groups">
        {%- for topic in topics -%}
          <div class="help__group" data-faq-group="{{ topic | handleize }}">
            <h2 class="help__group-title">{{ topic }}</h2>
            <div class="accordion help__list">
              {%- for block in section.blocks -%}
                {%- assign bt = block.settings.topic | strip | default: 'General' -%}
                {%- if bt == topic -%}
                  <details class="help__item" data-faq-item {{ block.shopify_attributes }}>
                    <summary>{{ block.settings.question }}</summary>
                    <div class="body rte">{{ block.settings.answer }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
        <p class="help__none" data-faq-none hidden>{{ section.settings.no_results_text }}</p>
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <div class="page-width help__body"><p class="help__none">Add “Question” blocks to build your FAQ.</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Help hub",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "How can we help?", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Search our answers below, or get in touch and we’ll help you get back out there." },
    { "type": "checkbox", "id": "show_search", "label": "Show FAQ search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for an answer" },
    { "type": "text", "id": "no_results_text", "label": "No results message", "default": "No answers found. Try a different word, or contact us below." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 50,
      "settings": [
        { "type": "text", "id": "topic", "label": "Topic", "default": "Orders", "info": "Questions with the same topic are grouped together. Topics appear as the tiles above the FAQ." },
        { "type": "text", "id": "question", "label": "Question", "default": "Where is my order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Help hub" }]
}
{% endschema %}
