{%- comment -%}
  "Still need help?" band: contact channels (blocks) beside a contact form that emails the
  store's customer email address (Shopify's built-in contact form).
{%- endcomment -%}
<section class="contact section-pad" id="contact">
  <div class="page-width contact__grid">

    <div class="contact__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2 contact__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="contact__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="contact__channels">
          {%- for block in section.blocks -%}
            {%- assign link_url = block.settings.link -%}
            {%- if link_url == blank and block.settings.icon == 'email' and shop.email != blank -%}
              {%- assign link_url = 'mailto:' | append: shop.email -%}
            {%- endif -%}
            <li class="contact__channel" {{ block.shopify_attributes }}>
              <span class="contact__icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  {%- case block.settings.icon -%}
                    {%- when 'email' -%}
                      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
                    {%- when 'phone' -%}
                      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
                    {%- when 'chat' -%}
                      <path d="M4 5h16v11H9l-5 4z"/>
                    {%- when 'returns' -%}
                      <path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
                    {%- when 'location' -%}
                      <path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
                  {%- endcase -%}
                </svg>
              </span>
              <div>
                <h3 class="contact__channel-title">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
                {%- if block.settings.link_label != blank and link_url != blank -%}
                  <a href="{{ link_url }}" class="contact__channel-link">{{ block.settings.link_label }}</a>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="contact__card">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        <h3 class="contact__form-title">{{ section.settings.form_heading }}</h3>

        {%- if form.posted_successfully? -%}
          <p class="review-form__notice review-form__notice--success" role="status">{{ section.settings.success_text }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="review-form__notice review-form__notice--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="review-form__fields">
            <div class="contact-form__row">
              <label class="review-form__field">
                <span>Name</span>
                <input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" required>
              </label>
              <label class="review-form__field">
                <span>Email</span>
                <input type="email" name="contact[email]" autocomplete="email" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" required>
              </label>
            </div>

            {%- assign topic_lines = section.settings.topics | newline_to_br | split: '<br />' -%}
            {%- if topic_lines.size > 0 and section.settings.topics != blank -%}
              <label class="review-form__field">
                <span>What can we help with?</span>
                <select name="contact[Topic]" required>
                  <option value="" disabled selected>Choose a topic</option>
                  {%- for line in topic_lines -%}
                    {%- assign topic_name = line | strip -%}
                    {%- if topic_name != blank -%}<option value="{{ topic_name | escape }}">{{ topic_name }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}

            {%- if section.settings.show_order_number -%}
              <label class="review-form__field">
                <span>Order number <em>(optional)</em></span>
                <input type="text" name="contact[Order number]" placeholder="e.g. #1001">
              </label>
            {%- endif -%}

            <label class="review-form__field">
              <span>Message</span>
              <textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </label>
          </div>

          <button type="submit" class="btn btn--full">{{ section.settings.button_label }}</button>
          {%- if section.settings.reply_note != blank -%}
            <p class="review-form__hint">{{ section.settings.reply_note }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still need a hand?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Can’t find what you’re looking for? Send us a message and a real person will come back to you." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "textarea", "id": "topics", "label": "Topic options", "default": "Order status\nDelivery\nReturns and exchanges\nSizing and fit\nProduct care\nSomething else", "info": "One per line. Leave empty to hide the topic menu." },
    { "type": "checkbox", "id": "show_order_number", "label": "Ask for an order number", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "reply_note", "label": "Note under the button", "default": "We aim to reply within one working day." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks, your message is on its way. We’ll be in touch soon." }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Contact channel",
      "limit": 5,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "email", "options": [
          { "value": "email", "label": "Email" },
          { "value": "phone", "label": "Phone" },
          { "value": "chat", "label": "Chat" },
          { "value": "returns", "label": "Returns" },
          { "value": "location", "label": "Location" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Email us" },
        { "type": "text", "id": "text", "label": "Text", "default": "We reply within one working day." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Send an email" },
        { "type": "url", "id": "link", "label": "Link", "info": "Email channels use your store’s customer email when this is empty." }
      ]
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
