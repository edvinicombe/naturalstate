<section class="quality section-pad">
  <div class="page-width">
    <div class="quality__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="h2 quality__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p class="quality__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width">
    <div class="quality__stage" data-hotspots>
      {%- if section.settings.stage_image != blank -%}
        <img src="{{ section.settings.stage_image | image_url: width: 2000 }}" alt="{{ section.settings.stage_alt | escape }}" loading="lazy" width="2000" height="1125">
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          <div class="hotspot{% if block.settings.x > 55 %} hotspot--left{% endif %}{% if block.settings.y > 55 %} hotspot--up{% endif %}" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <button type="button" class="hotspot__dot" aria-expanded="false" aria-controls="Hotspot-{{ block.id }}" aria-label="{{ block.settings.title | escape }}"><span></span></button>
            <div class="hotspot__card" id="Hotspot-{{ block.id }}">
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- assign tile_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'tile' -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if tile_count > 0 -%}
    <div class="page-width">
      <div class="quality__tiles">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            <figure class="quality-tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="" loading="lazy" width="1000" height="1000">
              {%- endif -%}
              <figcaption>
                <h3>{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </figcaption>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- assign proof_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'proof' -%}{%- assign proof_count = proof_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if proof_count > 0 -%}
    <div class="page-width">
      <ul class="quality__proof">
        {%- for block in section.blocks -%}
          {%- if block.type == 'proof' -%}
            <li {{ block.shopify_attributes }}>
              <span class="quality__proof-n">{{ block.settings.number }}</span>
              <span class="quality__proof-l">{{ block.settings.label }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Quality showcase",
  "settings": [
    { "type": "text",     "id": "eyebrow", "label": "Eyebrow", "default": "Built to last" },
    { "type": "text",     "id": "heading", "label": "Heading", "default": "Quality you can feel" },
    { "type": "textarea", "id": "intro",   "label": "Intro", "default": "Every detail is chosen, tested and tested again, so the gear gets out of your way and lets you run." },
    { "type": "header",   "content": "Feature image" },
    { "type": "image_picker", "id": "stage_image", "label": "Large image", "info": "Wide (16:9) works best. Add Hotspot blocks to point out details on it." },
    { "type": "text",     "id": "stage_alt", "label": "Image description (for screen readers)" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 6,
      "settings": [
        { "type": "range", "id": "x", "label": "Position from left", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 30 },
        { "type": "range", "id": "y", "label": "Position from top",  "min": 0, "max": 100, "step": 2, "unit": "%", "default": 40 },
        { "type": "text",     "id": "title", "label": "Title", "default": "Breathable fabric" },
        { "type": "textarea", "id": "text",  "label": "Text" }
      ]
    },
    {
      "type": "tile",
      "name": "Detail tile",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Close-ups of fabric, stitching and details work best." },
        { "type": "text",         "id": "title", "label": "Title", "default": "Detail" },
        { "type": "textarea",     "id": "text",  "label": "Text" }
      ]
    },
    {
      "type": "proof",
      "name": "Proof point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number or word", "default": "100%" },
        { "type": "text", "id": "label",  "label": "Label", "default": "Trail tested" }
      ]
    }
  ],
  "presets": [{ "name": "Quality showcase" }]
}
{% endschema %}
