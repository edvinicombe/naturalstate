<section class="mission section-pad">
  <div class="page-width mission__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mission__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="mission__heading">{{ section.settings.heading }}</h2>
    <p class="mission__tagline">{{ section.settings.tagline }}</p>
    <div class="mission__aside">
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--ghost">
          {{- section.settings.button_label -}}
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="mission__rail-wrap" data-rail-wrap>
      <ul class="mission__rail" data-rail tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          <li class="mission-tile{% if block.settings.image != blank %} mission-tile--image{% endif %}" style="--tile-bg: {{ block.settings.tile_bg }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img class="mission-tile__img" src="{{ block.settings.image | image_url: width: 900 }}" alt="" loading="lazy" width="720" height="960">
            {%- endif -%}
            <span class="mission-tile__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <div class="mission-tile__body">
              <h3 class="mission-tile__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="mission-tile__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="page-width mission__controls">
        <div class="mission__progress" aria-hidden="true"><span data-rail-progress></span></div>
        <div class="mission__arrows">
          <button type="button" class="rail-btn" data-rail-prev aria-label="Previous">
            <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
          </button>
          <button type="button" class="rail-btn" data-rail-next aria-label="Next">
            <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Our mission",
  "settings": [
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow", "default": "Natural State" },
    { "type": "text",     "id": "heading",      "label": "Heading", "default": "Our mission" },
    { "type": "text",     "id": "tagline",      "label": "Mission statement", "default": "Born from running free" },
    { "type": "textarea", "id": "text",         "label": "Supporting text", "default": "I’m Ed, a designer and runner. I created Natural State around the feeling I keep coming back to when I run: freedom, clarity and being completely yourself. Your natural state." },
    { "type": "text",     "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url",      "id": "button_link",  "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Mission tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image",   "label": "Image", "info": "Portrait works best (3:4). Leave empty for a solid colour tile." },
        { "type": "text",         "id": "title",   "label": "Statement", "default": "Run free." },
        { "type": "textarea",     "id": "text",    "label": "Supporting text" },
        { "type": "color",        "id": "tile_bg", "label": "Colour (when no image)", "default": "#141414" }
      ]
    }
  ],
  "presets": [{ "name": "Our mission" }]
}
{% endschema %}
