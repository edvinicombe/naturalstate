{%- assign related_count = 0 -%}
{%- capture related_cards -%}
  {%- for p in product.collections.first.products limit: 9 -%}
    {%- if p.id != product.id and related_count < section.settings.limit -%}
      {%- render 'product-card', product: p -%}
      {%- assign related_count = related_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if related_count > 0 -%}
  <section class="section-pad" id="you-might-also-like">
    <div class="page-width">
      <div class="section-header">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      <div class="product-grid">
        {{ related_cards }}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "You Might Also Like",
  "settings": [
    { "type": "text",  "id": "heading", "label": "Heading", "default": "You Might Also Like" },
    { "type": "range", "id": "limit",   "label": "Number of products", "min": 2, "max": 8, "step": 2, "default": 4 }
  ]
}
{% endschema %}
