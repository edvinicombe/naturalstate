{%- assign related_products = product.collections.first.products | where_exp: 'p', 'p.id != product.id' -%}
{%- if related_products.size > 0 -%}
  <section class="section-pad" id="you-might-also-like">
    <div class="page-width">
      <div class="section-header">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      <div class="product-grid">
        {%- for p in related_products limit: section.settings.limit -%}
          {%- render 'product-card', product: p -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "You Might Also Like",
  "settings": [
    { "type": "text",  "id": "heading", "label": "Heading", "default": "You Might Also Like" },
    { "type": "range", "id": "limit",   "label": "Number of products", "min": 2, "max": 8, "step": 2, "default": 4 }
  ]
}
{% endschema %}
