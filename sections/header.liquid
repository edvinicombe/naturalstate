{%- if section.settings.announcement != blank -%}
  <div class="announcement-bar">{{ section.settings.announcement }}</div>
{%- endif -%}

<header class="site-header{% if template.name == 'index' %} site-header--transparent{% endif %}">
  <div class="page-width">
    <div class="site-header__inner">

      <button class="mobile-toggle" id="DrawerOpen" aria-label="Open menu">
        <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
        {%- else -%}
          <img src="{{ 'logo-ns.svg' | asset_url }}" alt="{{ shop.name }}">
        {%- endif -%}
      </a>

      <nav aria-label="Main">
        <ul class="site-nav">
          {%- for link in linklists[section.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header-icons">
        <a href="{{ routes.account_url }}" aria-label="Account">
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm240-320q33 0 56.5-23.5T560-640q0-33-23.5-56.5T480-720q-33 0-56.5 23.5T400-640q0 33 23.5 56.5T480-560Zm0-80Zm0 400Z"/></svg>
        </a>
        <button type="button" id="SavedOpen" aria-label="Saved products">
          {%- render 'icon-heart', size: 24 -%}
          <span class="cart-count saved-count-badge" style="display:none;">0</span>
        </button>
        <a href="{{ routes.cart_url }}" data-cart-link aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M240-80q-33 0-56.5-23.5T160-160v-480q0-33 23.5-56.5T240-720h80q0-66 47-113t113-47q66 0 113 47t47 113h80q33 0 56.5 23.5T800-640v480q0 33-23.5 56.5T720-80H240Zm0-80h480v-480h-80v80q0 17-11.5 28.5T600-520q-17 0-28.5-11.5T560-560v-80H400v80q0 17-11.5 28.5T360-520q-17 0-28.5-11.5T320-560v-80h-80v480Zm160-560h160q0-33-23.5-56.5T480-800q-33 0-56.5 23.5T400-720ZM240-160v-480 480Z"/></svg>
          <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>
</header>

<div class="mobile-drawer" id="MobileDrawer" aria-hidden="true">
  <button class="mobile-drawer__close" id="DrawerClose" aria-label="Close menu">
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <nav>
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a href="{{ routes.account_url }}">Account</a>
    <button type="button" id="SavedOpenMobile">Saved (<span class="saved-count-text">0</span>)</button>
    <a href="{{ routes.cart_url }}">Bag (<span data-cart-count-text>{{ cart.item_count }}</span>)</a>
  </nav>
</div>

<div class="saved-drawer" id="SavedDrawer" aria-hidden="true">
  <button class="saved-drawer__close" id="SavedDrawerClose" aria-label="Close saved products">
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <h2 class="h3" style="margin-bottom:24px;">Saved</h2>
  <div id="SavedGrid" class="saved-drawer__grid"></div>
  <div id="SavedEmpty" class="cart-empty" style="display:none;padding:64px 0;">
    <p style="margin-bottom:24px;">You haven't saved anything yet.</p>
    <a href="{{ routes.root_url }}" class="btn">Start Shopping</a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "text",      "id": "announcement", "label": "Announcement bar text", "default": "Free UK shipping on orders over £75" }
  ]
}
{% endschema %}
