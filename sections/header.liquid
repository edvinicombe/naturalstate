{%- if section.settings.announcement != blank -%}
  <div class="announcement-bar" data-marquee-speed="{{ section.settings.announcement_speed }}">
    <div class="announcement-bar__track">
      {%- for group in (1..2) -%}
        <div class="announcement-bar__group"{% if group == 2 %} aria-hidden="true"{% endif %}>
          {%- for i in (1..8) -%}
            <span class="announcement-bar__item"{% if group == 2 or i > 1 %} aria-hidden="true"{% endif %}>{{ section.settings.announcement }}</span>
            <span class="announcement-bar__bullet" aria-hidden="true">&bull;</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<header class="site-header{% if template.name == 'index' %} site-header--transparent{% endif %}">
  <div class="page-width">
    <div class="site-header__inner">

      <button class="mobile-toggle" id="DrawerOpen" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
        {%- else -%}
          <img src="{{ 'logo-ns.svg' | asset_url }}" alt="{{ shop.name }}">
        {%- endif -%}
      </a>

      <nav aria-label="Main">
        <ul class="site-nav">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header-icons">
        <button type="button" id="SavedOpen" class="header-saved" aria-label="Saved products">
          {%- render 'icon-heart', size: 24 -%}
          <span class="cart-count saved-count-badge" style="display:none;">0</span>
        </button>
        <a href="{{ routes.cart_url }}" data-cart-link aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M240-80q-33 0-56.5-23.5T160-160v-480q0-33 23.5-56.5T240-720h80q0-66 47-113t113-47q66 0 113 47t47 113h80q33 0 56.5 23.5T800-640v480q0 33-23.5 56.5T720-80H240Zm0-80h480v-480h-80v80q0 17-11.5 28.5T600-520q-17 0-28.5-11.5T560-560v-80H400v80q0 17-11.5 28.5T360-520q-17 0-28.5-11.5T320-560v-80h-80v480Zm160-560h160q0-33-23.5-56.5T480-800q-33 0-56.5 23.5T400-720ZM240-160v-480 480Z"/></svg>
          <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>
</header>

<div class="mobile-drawer" id="MobileDrawer" aria-hidden="true">
  <button class="mobile-drawer__close" id="DrawerClose" aria-label="Close menu">
    <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
  </button>
  <nav>
    {%- for block in section.blocks -%}
      {%- if block.settings.label != blank -%}
        <a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a>
      {%- endif -%}
    {%- endfor -%}
    <button type="button" id="SavedOpenMobile">Saved (<span class="saved-count-text">0</span>)</button>
    <a href="{{ routes.cart_url }}">Bag (<span data-cart-count-text>{{ cart.item_count }}</span>)</a>
  </nav>
</div>

<div class="saved-drawer" id="SavedDrawer" aria-hidden="true">
  <button class="saved-drawer__close" id="SavedDrawerClose" aria-label="Close saved products">
    <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
  </button>
  <h2 class="h3" style="margin-bottom:24px;">Saved</h2>
  <div id="SavedGrid" class="saved-drawer__grid"></div>
  <div id="SavedEmpty" class="cart-empty" style="display:none;padding:64px 0;">
    <p style="margin-bottom:24px;">You haven't saved anything yet.</p>
    <a href="{{ routes.root_url }}" class="btn">Start Shopping</a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "info": "Scrolls across the top of the site, repeated with a bullet between each.", "default": "Free UK shipping on orders over £75" },
    { "type": "range", "id": "announcement_speed", "label": "Scroll speed", "info": "Pixels per second. 22 matches the slow ticker on on.com.", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 22 }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Menu link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Catalog" },
        { "type": "url",  "id": "url",   "label": "Link", "default": "/collections/all" }
      ]
    }
  ]
}
{% endschema %}
