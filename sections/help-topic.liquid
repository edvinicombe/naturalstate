{%- comment -%}
  Topic page. All questions live here as blocks; a page shows only the ones whose topic
  matches its own title (e.g. the page "Returns and refunds" shows the "Returns and refunds"
  questions). Use this template ("page.help") for every topic page.
{%- endcomment -%}
{%- assign page_topic = page.title | handleize -%}
{%- assign shown = 0 -%}
<section class="help-center help-topic section-pad">
  <div class="page-width help-topic__inner">
    {%- if section.settings.back_link != blank -%}
      <a href="{{ section.settings.back_link }}" class="help-back">
        {%- render 'icon', name: 'back' -%}{{ section.settings.back_label }}
      </a>
    {%- endif -%}
    <h1 class="h1 help-center__title help-topic__title">{{ page.title }}</h1>

    <div class="help-topic__body">
      <div class="accordion help-faq">
        {%- for block in section.blocks -%}
          {%- assign block_topic = block.settings.topic | handleize -%}
          {%- if block_topic == page_topic -%}
            {%- assign shown = shown | plus: 1 -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="body">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if shown == 0 -%}
        <p class="help-faq__empty">
          {%- if request.design_mode -%}
            No questions use the topic “{{ page.title }}” yet. Add a Question block and set its topic to exactly that.
          {%- else -%}
            {{ section.settings.empty_text }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Help topic FAQ",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Get help" },
    { "type": "url", "id": "back_link", "label": "Back link", "default": "/pages/contact" },
    { "type": "text", "id": "empty_text", "label": "No questions message", "default": "We’re still adding answers for this topic. Please get in touch and we’ll help." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 50,
      "settings": [
        { "type": "text", "id": "topic", "label": "Topic", "default": "General questions", "info": "Must match the title of the help page, e.g. “Returns and refunds”." },
        { "type": "text", "id": "question", "label": "Question", "default": "Where is my order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Help topic FAQ" }]
}
{% endschema %}
