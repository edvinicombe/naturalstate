<section class="drop section-pad" id="drop">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow section-header__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank and section.settings.link_label != blank -%}
        <a href="{{ section.settings.collection.url }}" class="drop__all">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="drop__wrap" data-rail-wrap>
    <ul class="drop__rail" data-rail tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: 50 -%}
          <li class="drop__item">{%- render 'product-card', product: product -%}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li class="drop__item">
            <div class="product-card">
              <div class="product-card__media product-card__media--empty"><span>Choose a collection in Customize</span></div>
              <p class="product-card__title">Sample product</p>
              <p class="product-card__price">£0.00</p>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    <div class="page-width drop__controls">
      <div class="mission__progress" aria-hidden="true"><span data-rail-progress></span></div>
      <div class="mission__arrows">
        <button type="button" class="rail-btn" data-rail-prev aria-label="Previous products">
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
        </button>
        <button type="button" class="rail-btn" data-rail-next aria-label="Next products">
          <svg width="24" height="24" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Drop carousel",
  "settings": [
    { "type": "text",       "id": "eyebrow",    "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text",       "id": "heading",    "label": "Heading", "default": "Feel the run" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Every product in this collection appears in the carousel (up to 50)." },
    { "type": "text",       "id": "link_label", "label": "“View all” link label", "info": "Links to the collection page. Leave empty to hide.", "default": "Shop the drop" }
  ],
  "presets": [{ "name": "Drop carousel" }]
}
{% endschema %}
