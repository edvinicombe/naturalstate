<footer class="site-footer">
  <div class="page-width">
    <div class="footer-grid">

      <div class="footer-col footer-motto">
        <img src="{{ 'motto-feel-the-run.svg' | asset_url }}" alt="Feel The Run" loading="lazy">
        <p>{{ section.settings.tagline }}</p>
      </div>

      {%- assign shop_links = linklists[section.settings.shop_menu].links -%}
      {%- if shop_links.size > 0 -%}
        <div class="footer-col">
          <h4>Shop</h4>
          <ul>
            {%- for link in shop_links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- assign company_links = linklists[section.settings.company_menu].links -%}
      {%- if company_links.size > 0 -%}
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            {%- for link in company_links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- assign help_links = linklists[section.settings.help_menu].links -%}
      {%- if help_links.size > 0 or shop.policies.size > 0 -%}
        <div class="footer-col">
          <h4>Help</h4>
          <ul>
            {%- if help_links.size > 0 -%}
              {%- for link in help_links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for policy in shop.policies -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="footer-col footer-newsletter">
        <h4>Stay in the pack</h4>
        <p>Early drops and runner news, straight to your inbox.</p>
        {%- form 'customer', id: 'FooterSignup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form">
            <input type="email" name="contact[email]" placeholder="Your email" required>
            <button type="submit" class="btn" style="padding:13px 20px;">Join</button>
          </div>
        {%- endform -%}
      </div>

    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="footer-payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer-payments__icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="footer-social">
        {%- assign instagram_url = settings.social_instagram | default: 'https://www.instagram.com/' -%}
        {%- assign strava_url = settings.social_strava | default: 'https://www.strava.com/' -%}
        {%- assign tiktok_url = settings.social_tiktok | default: 'https://www.tiktok.com/' -%}
        <a href="{{ instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="{{ strava_url }}" aria-label="Strava" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 14.5L11.5 3.5 17 14.5"/><path d="M13.5 14.5l2.75 5.5 2.75-5.5"/></svg>
        </a>
        <a href="{{ tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 3v11.2a4 4 0 1 1-4-4"/><path d="M14.5 3c.3 2.7 2.1 4.5 5 4.7"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text",      "id": "tagline",      "label": "Footer tagline", "default": "Gear built for runners who chase open roads and quiet trails." },
    { "type": "link_list", "id": "shop_menu",    "label": "Shop menu",    "default": "main-menu" },
    { "type": "link_list", "id": "company_menu", "label": "Company menu", "default": "footer" },
    { "type": "link_list", "id": "help_menu",    "label": "Help menu", "info": "Optional. If left empty, the Help column lists your store policies (refund, shipping, privacy, terms) automatically." }
  ]
}
{% endschema %}
