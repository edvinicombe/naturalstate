<footer class="site-footer">
  <div class="page-width">
    <div class="footer-center">

      <div class="footer-newsletter">
        <h4>Stay in the pack</h4>
        <p style="color:var(--muted);font-size:0.85rem;margin-bottom:16px;line-height:1.6;">Early drops and runner news, straight to your inbox.</p>
        {%- form 'customer', id: 'FooterSignup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form">
            <input type="email" name="contact[email]" placeholder="Your email" required>
            <button type="submit" class="btn" style="padding:13px 20px;">Join</button>
          </div>
        {%- endform -%}
      </div>

      <div class="footer-motto">
        <img src="{{ 'motto-feel-the-run.svg' | asset_url }}" alt="Feel The Run" loading="lazy">
        <p>{{ section.settings.tagline }}</p>
      </div>

    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="footer-payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer-payments__icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="footer-social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram">Instagram</a>
        {%- endif -%}
        {%- if settings.social_strava != blank -%}
          <a href="{{ settings.social_strava }}" aria-label="Strava">Strava</a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok">TikTok</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Footer tagline", "default": "Gear built for runners who chase open roads and quiet trails." }
  ]
}
{% endschema %}
