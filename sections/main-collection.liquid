{%- paginate collection.products by section.settings.per_page -%}
  <div class="page-width collection">
    <header class="collection__head">
      <div>
        {%- comment -%} H1: the collection's own title (Running, Lifestyle…); the editable "Shop all" when showing everything. A tag in the URL is added in front (Men’s Running) or, on the full catalog, replaces it (Men’s). {%- endcomment -%}
        {%- if collection.handle == 'all' or collection.handle == blank -%}
          {%- assign page_heading = section.settings.heading | default: 'Shop all' -%}
          {%- assign is_all = true -%}
        {%- else -%}
          {%- assign page_heading = collection.title -%}
          {%- assign is_all = false -%}
        {%- endif -%}
        {%- if current_tags.size > 0 -%}
          {%- assign first_tag = current_tags | first -%}
          {%- assign first_handle = first_tag | handleize -%}
          {%- assign mens_handle = section.settings.mens_tag | default: 'mens' | handleize -%}
          {%- assign womens_handle = section.settings.womens_tag | default: 'womens' | handleize -%}
          {%- if first_handle == mens_handle -%}
            {%- assign tag_label = 'Men’s' -%}
          {%- elsif first_handle == womens_handle -%}
            {%- assign tag_label = 'Women’s' -%}
          {%- else -%}
            {%- assign tag_label = first_tag -%}
          {%- endif -%}
          {%- if is_all -%}
            {%- assign page_heading = tag_label -%}
          {%- else -%}
            {%- assign page_heading = tag_label | append: ' ' | append: collection.title -%}
          {%- endif -%}
        {%- endif -%}
        <h1 class="h1 collection__title">{{ page_heading }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection__desc">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      <p class="collection__count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
    </header>

    <div class="collection__bar">
      {%- if section.settings.show_gender_filter -%}
        {%- assign mens_tag = section.settings.mens_tag | default: 'mens' | handleize -%}
        {%- assign womens_tag = section.settings.womens_tag | default: 'womens' | handleize -%}
        {%- assign is_mens = false -%}
        {%- assign is_womens = false -%}
        {%- comment -%} current_tags keep the tag's original casing, so compare handles. {%- endcomment -%}
        {%- for t in current_tags -%}
          {%- assign t_handle = t | handleize -%}
          {%- if t_handle == mens_tag -%}{%- assign is_mens = true -%}{%- endif -%}
          {%- if t_handle == womens_tag -%}{%- assign is_womens = true -%}{%- endif -%}
        {%- endfor -%}
        <nav class="collection__chips" aria-label="Filter by">
          <a href="{{ collection.url }}"{% unless is_mens or is_womens %} aria-current="true" class="is-active"{% endunless %}>All</a>
          <a href="{{ collection.url }}/{{ mens_tag }}"{% if is_mens %} aria-current="true" class="is-active"{% endif %}>Men’s</a>
          <a href="{{ collection.url }}/{{ womens_tag }}"{% if is_womens %} aria-current="true" class="is-active"{% endif %}>Women’s</a>
        </nav>
      {%- endif -%}
      {%- if section.settings.show_sort and collection.sort_options.size > 1 -%}
        {%- assign tag_path = '' -%}
        {%- for t in current_tags -%}{%- assign t_h = t | handleize -%}{%- assign tag_path = tag_path | append: t_h -%}{%- unless forloop.last -%}{%- assign tag_path = tag_path | append: '+' -%}{%- endunless -%}{%- endfor -%}
        <form class="collection__sort" method="get" action="{{ collection.url }}{% if tag_path != blank %}/{{ tag_path }}{% endif %}">
          <label for="CollectionSort" class="visually-hidden">Sort by</label>
          <select id="CollectionSort" name="sort_by" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="btn btn--ghost">Sort</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid{% if section.settings.columns == '3' %} product-grid--3{% endif %}">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="collection__pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- else -%}
      <div class="collection__empty">
        <p>No products found here yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">View the full catalog</a>
      </div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (H1) for all products", "default": "Shop all", "info": "Used when the page shows every product. Other collections show their own title." },
    { "type": "select", "id": "columns", "label": "Products per row (desktop)", "default": "3", "options": [ { "value": "3", "label": "3 (larger cards)" }, { "value": "4", "label": "4" } ] },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "checkbox", "id": "show_gender_filter", "label": "Show All / Men’s / Women’s filter", "default": true },
    { "type": "text", "id": "mens_tag", "label": "Men’s product tag", "default": "mens", "info": "Must match the tag on your men’s products." },
    { "type": "text", "id": "womens_tag", "label": "Women’s product tag", "default": "womens", "info": "Must match the tag on your women’s products." },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort menu", "default": true }
  ]
}
{% endschema %}
