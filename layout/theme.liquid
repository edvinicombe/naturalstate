<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon -%}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- if settings.font_heading.family != blank -%}
    {{ settings.font_heading | font_face }}
  {%- endif -%}
  {%- if settings.font_body.family != blank -%}
    {{ settings.font_body | font_face }}
  {%- endif -%}
</head>
<body>
  {% sections 'header-group' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
