{%- assign filled = rating | round -%}
<span class="stars"{% if decorative %} aria-hidden="true"{% else %} role="img" aria-label="{{ rating }} out of 5 stars"{% endif %}>
  {%- for i in (1..5) -%}
    <span class="stars__star{% if i <= filled %} is-on{% endif %}" aria-hidden="true">&#9733;</span>
  {%- endfor -%}
</span>
