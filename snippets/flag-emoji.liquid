{%- comment -%}
  Flag emoji for a two-letter country code (regional indicator symbols). Param: code.
{%- endcomment -%}
{%- assign flag_code = code | strip | upcase -%}
{%- if flag_code.size == 2 -%}
  {%- assign flag_letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' -%}
  {%- assign flag_glyphs = '🇦,🇧,🇨,🇩,🇪,🇫,🇬,🇭,🇮,🇯,🇰,🇱,🇲,🇳,🇴,🇵,🇶,🇷,🇸,🇹,🇺,🇻,🇼,🇽,🇾,🇿' | split: ',' -%}
  {%- assign flag_a = flag_code | slice: 0 -%}
  {%- assign flag_b = flag_code | slice: 1 -%}
  {%- assign flag_ia = flag_letters | split: flag_a | first | size -%}
  {%- assign flag_ib = flag_letters | split: flag_b | first | size -%}
  {{- flag_glyphs[flag_ia] }}{{ flag_glyphs[flag_ib] -}}
{%- endif -%}
