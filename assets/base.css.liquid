/* ================================================
   NATURAL STATE RUNNING GEAR — v2.0
   ================================================ */

:root {
  --bg:          {{ settings.color_background }};
  --surface:     {{ settings.color_surface }};
  --border:      {{ settings.color_border }};
  --text:        {{ settings.color_text }};
  --muted:       {{ settings.color_text_muted }};
  --accent:      {{ settings.color_accent }};
  --accent-text: {{ settings.color_accent_text }};
  --max-w:       {{ settings.page_width }}px;
  --gap:         24px;
  --font-body:    {% if settings.font_body.family != blank %}{{ settings.font_body.family }},{% endif %} -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-heading: {% if settings.font_heading.family != blank %}{{ settings.font_heading.family }},{% endif %} -apple-system, "Helvetica Neue", Arial, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
}

img { display: block; max-width: 100%; }
a   { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }

/* ── Layout ── */
.page-width {
  max-width: var(--max-w);
  margin: 0 auto;
  padding-inline: 40px;
}
@media (max-width: 749px) { .page-width { padding-inline: 20px; } }

.section-pad        { padding-block: 96px; }
.section-pad--sm    { padding-block: 64px; }
@media (max-width: 749px) {
  .section-pad     { padding-block: 60px; }
  .section-pad--sm { padding-block: 40px; }
}

/* ── Type ── */
h1,h2,h3,h4,h5 {
  font-family: var(--font-heading);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 1.0;
  margin: 0;
}
.h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); }
.h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
.h3 { font-size: clamp(1.2rem, 2vw, 1.6rem); }

.eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 600;
  margin: 0;
}

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px 34px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 100px;
  border: 1.5px solid var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  transition: opacity 0.18s, transform 0.18s;
  white-space: nowrap;
  font-family: var(--font-body);
}
.btn:hover  { opacity: 0.82; }
.btn:active { transform: scale(0.97); }
.btn--ghost {
  background: transparent;
  color: var(--text);
  border-color: rgba(245,243,239,0.35);
}
.btn--ghost:hover { border-color: var(--text); opacity: 1; }
.btn--full  { width: 100%; }
.btn--lg    { padding: 18px 42px; font-size: 0.88rem; }
.btn:disabled { opacity: 0.38; cursor: not-allowed; }

/* ── Announcement bar ── */
.announcement-bar {
  background: var(--text);
  color: var(--bg);
  text-align: center;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 9px 16px;
}

/* ── Header ── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10,10,10,0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
  gap: 20px;
}
.site-header__logo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.site-header__logo img { height: 80px; width: auto; }

.site-nav {
  display: flex;
  gap: 32px;
  list-style: none;
  margin: 0;
  padding: 0;
}
.site-nav a {
  font-size: 0.78rem;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--text);
  position: relative;
  padding-bottom: 3px;
}
.site-nav a::after {
  content: "";
  position: absolute;
  left: 0; bottom: 0;
  width: 0; height: 1px;
  background: var(--text);
  transition: width 0.22s ease;
}
.site-nav a:hover::after { width: 100%; }

.header-icons {
  display: flex;
  align-items: center;
  gap: 20px;
}
.header-icons a,
.header-icons button {
  background: none;
  border: none;
  color: var(--text);
  display: flex;
  align-items: center;
  position: relative;
  padding: 0;
}
.cart-count {
  position: absolute;
  top: -7px; right: -9px;
  background: var(--text);
  color: var(--bg);
  font-size: 0.6rem;
  font-weight: 800;
  width: 16px; height: 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-toggle { display: none; background: none; border: none; color: var(--text); }
@media (max-width: 899px) {
  .site-nav     { display: none; }
  .mobile-toggle { display: block; }
  .site-header__inner { position: relative; }
  .site-header__logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
}

/* Mobile drawer */
.mobile-drawer {
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 200;
  padding: 24px 28px;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(.4,0,.2,1);
  overflow-y: auto;
}
.mobile-drawer.open { transform: translateX(0); }
.mobile-drawer__close {
  background: none;
  border: none;
  color: var(--text);
  margin-bottom: 36px;
  display: block;
}
.mobile-drawer nav {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.mobile-drawer nav a {
  font-size: 1.5rem;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* ── Hero ── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: var(--surface);
}
.hero__bg {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 20%, rgba(0,0,0,0.78) 100%);
  z-index: 1;
}
.hero__content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding-bottom: 72px;
}
.hero__content .eyebrow { color: rgba(245,243,239,0.7); margin-bottom: 16px; }
.hero__content h1 { color: var(--text); margin-bottom: 30px; max-width: 14ch; }
.hero__actions { display: flex; gap: 14px; flex-wrap: wrap; }
@media (max-width: 749px) {
  .hero { min-height: 75vh; }
  .hero__content { padding-bottom: 44px; }
}

/* ── Section header ── */
.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 40px;
  gap: 20px;
}

/* ── Product grid ── */
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap);
}
@media (max-width: 1100px) { .product-grid { grid-template-columns: repeat(3,1fr); } }
@media (max-width: 749px)  { .product-grid { grid-template-columns: repeat(2,1fr); gap: 14px; } }

/* ── Product card ── */
.product-card { display: block; }
.product-card__media {
  position: relative;
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: 16px;
  border-radius: 2px;
}
.product-card__media img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.55s ease, opacity 0.35s ease;
}
.product-card__media .img-secondary {
  position: absolute; inset: 0;
  opacity: 0;
}
.product-card:hover .img-primary   { opacity: 0; }
.product-card:hover .img-secondary { opacity: 1; }
.product-card:hover .img-primary:only-child { opacity: 1; transform: scale(1.04); }

.product-card__badge {
  position: absolute;
  top: 12px; left: 12px;
  background: var(--accent);
  color: var(--accent-text);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 100px;
  z-index: 1;
}

.product-card__title {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: 5px;
}
.product-card__price {
  font-size: 0.88rem;
  color: var(--muted);
}
.product-card__price s { margin-right: 5px; opacity: 0.6; }

/* ── Story / Image+text block ── */
.story-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.story-block.reversed > *:first-child { order: 2; }
.story-block__img {
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
}
.story-block__img img { width: 100%; height: 100%; object-fit: cover; }
.story-block__text .eyebrow { margin-bottom: 16px; }
.story-block__text h2 { margin-bottom: 20px; }
.story-block__text p {
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 16px;
}
@media (max-width: 849px) {
  .story-block, .story-block.reversed { grid-template-columns: 1fr; }
  .story-block.reversed > *:first-child { order: 0; }
}

/* ── Newsletter banner ── */
.newsletter-block {
  background: var(--surface);
  text-align: center;
  padding: 88px 40px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.newsletter-block h2 { margin-bottom: 14px; }
.newsletter-block p  { color: var(--muted); margin-bottom: 32px; max-width: 440px; margin-inline: auto; }
.newsletter-form {
  display: flex;
  gap: 10px;
  max-width: 400px;
  margin-inline: auto;
}
.newsletter-form input {
  flex: 1;
  background: transparent;
  border: 1.5px solid var(--border);
  color: var(--text);
  padding: 13px 18px;
  border-radius: 100px;
  font-size: 0.9rem;
  font-family: var(--font-body);
}
.newsletter-form input::placeholder { color: var(--muted); }
@media (max-width: 480px) { .newsletter-form { flex-direction: column; } }

/* ── Product page ── */
.product-layout {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 60px;
  align-items: start;
  padding-block: 48px 96px;
}
@media (max-width: 949px) { .product-layout { grid-template-columns: 1fr; gap: 32px; } }

.gallery__main {
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: 10px;
  border-radius: 2px;
}
.gallery__main img { width: 100%; height: 100%; object-fit: cover; }
.gallery__thumbs {
  display: grid;
  grid-template-columns: repeat(5,1fr);
  gap: 8px;
}
.gallery__thumb {
  aspect-ratio: 1;
  background: var(--surface);
  overflow: hidden;
  border: 1.5px solid transparent;
  border-radius: 2px;
  cursor: pointer;
}
.gallery__thumb.active { border-color: var(--text); }
.gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }

.product-info { position: sticky; top: 96px; }
.product-info__eyebrow { margin-bottom: 10px; }
.product-info__title { font-size: clamp(1.6rem,3vw,2.2rem); margin-bottom: 14px; max-width: 22ch; }
.product-info__price {
  font-size: 1.35rem;
  font-weight: 500;
  margin-bottom: 28px;
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.product-info__price s { color: var(--muted); font-size: 1rem; font-weight: 400; }
.price-sale { color: #e07a6e; }

.product-info__desc {
  color: var(--muted);
  font-size: 0.93rem;
  line-height: 1.75;
  margin-bottom: 32px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
}

.option-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 12px;
}
.option-label span { color: var(--muted); text-transform: none; letter-spacing: 0; font-weight: 400; }
.swatches { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 24px; }
.swatch {
  min-width: 50px;
  height: 44px;
  padding: 0 14px;
  border: 1.5px solid var(--border);
  border-radius: 4px;
  background: transparent;
  color: var(--text);
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s;
  cursor: pointer;
  font-family: var(--font-body);
}
.swatch:hover  { border-color: var(--muted); }
.swatch.active { border-color: var(--text); background: var(--text); color: var(--bg); }
.swatch.unavailable { opacity: 0.3; text-decoration: line-through; cursor: not-allowed; }

.product-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }

.accordion { margin-top: 36px; border-top: 1px solid var(--border); }
.accordion details { border-bottom: 1px solid var(--border); }
.accordion summary {
  list-style: none;
  cursor: pointer;
  padding: 17px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
}
.accordion summary::-webkit-details-marker { display: none; }
.accordion summary::after { content: "+"; font-size: 1.1rem; font-weight: 300; color: var(--muted); }
.accordion details[open] summary::after { content: "−"; }
.accordion .body {
  padding-bottom: 20px;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.75;
}

/* ── Breadcrumb ── */
.breadcrumb {
  font-size: 0.78rem;
  color: var(--muted);
  margin-bottom: 24px;
}
.breadcrumb a:hover { color: var(--text); }

/* ── Cart ── */
.cart-wrap { padding-block: 56px 96px; }
.cart-wrap h1 { margin-bottom: 48px; }
.cart-layout {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 56px;
  align-items: start;
}
@media (max-width: 899px) { .cart-layout { grid-template-columns: 1fr; } }
.cart-line {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 18px;
  padding: 24px 0;
  border-bottom: 1px solid var(--border);
}
.cart-line__img { aspect-ratio: 4/5; background: var(--surface); overflow: hidden; border-radius: 2px; }
.cart-line__img img { width: 100%; height: 100%; object-fit: cover; }
.cart-line__title { font-size: 0.93rem; font-weight: 500; margin-bottom: 5px; }
.cart-line__variant { font-size: 0.8rem; color: var(--muted); margin-bottom: 14px; }
.qty {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--border);
  border-radius: 100px;
  overflow: hidden;
}
.qty button { background: none; border: none; color: var(--text); width: 34px; height: 34px; font-size: 1rem; }
.qty input {
  width: 34px; text-align: center;
  background: none; border: none;
  color: var(--text); font-size: 0.85rem;
  font-family: var(--font-body);
}
.cart-line__price { text-align: right; font-size: 0.95rem; }
.cart-line__remove {
  font-size: 0.73rem;
  color: var(--muted);
  text-decoration: underline;
  display: inline-block;
  margin-top: 10px;
}
.order-summary {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 28px;
  position: sticky;
  top: 96px;
  border-radius: 4px;
}
.order-summary h3 { font-size: 1rem; margin-bottom: 22px; }
.summary-row { display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: 12px; }
.summary-row.total {
  font-size: 1.05rem; font-weight: 700;
  padding-top: 16px; margin-top: 16px;
  border-top: 1px solid var(--border);
}
.cart-empty { text-align: center; padding: 100px 0; color: var(--muted); }

/* ── Our Story ── */
.story-hero {
  text-align: center;
  padding: 100px 20px 64px;
  max-width: 700px;
  margin-inline: auto;
}
.story-hero .motto { max-width: 380px; margin-inline: auto; margin-bottom: 32px; }
.story-hero p { color: var(--muted); font-size: 1.05rem; line-height: 1.8; }

.stat-strip {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  text-align: center;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding-block: 56px;
  gap: 24px;
}
.stat-strip__n { font-size: clamp(1.8rem,3.5vw,2.8rem); font-family: var(--font-heading); margin-bottom: 8px; }
.stat-strip__l { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
@media (max-width: 749px) { .stat-strip { grid-template-columns: 1fr; gap: 40px; } }

/* ── Generic page ── */
.page-body { padding-block: 64px 96px; max-width: 720px; }
.page-body h1 { margin-bottom: 32px; }
.page-body div { color: var(--muted); line-height: 1.8; }

/* ── Search ── */
.search-form { display: flex; gap: 10px; max-width: 480px; margin-bottom: 56px; }
.search-form input {
  flex: 1;
  background: transparent;
  border: 1.5px solid var(--border);
  color: var(--text);
  padding: 13px 18px;
  border-radius: 100px;
  font-size: 0.9rem;
  font-family: var(--font-body);
}
.search-form input::placeholder { color: var(--muted); }

/* ── 404 / empty states ── */
.empty-state {
  text-align: center;
  padding: 120px 20px;
  color: var(--muted);
}
.empty-state h1 { color: var(--text); margin-bottom: 14px; }
.empty-state p  { margin-bottom: 32px; }

/* ── Footer ── */
.site-footer {
  border-top: 1px solid var(--border);
  padding-block: 80px 32px;
  margin-top: 0;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 56px;
}
.footer-col h4 {
  font-size: 0.7rem;
  letter-spacing: 0.16em;
  color: var(--muted);
  margin-bottom: 18px;
}
.footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
.footer-col a { font-size: 0.88rem; color: var(--text); opacity: 0.8; }
.footer-col a:hover { opacity: 1; }
.footer-motto img { max-width: 260px; margin-bottom: 16px; }
.footer-motto p { color: var(--muted); font-size: 0.85rem; max-width: 30ch; line-height: 1.65; }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  font-size: 0.73rem;
  color: var(--muted);
}
.footer-social { display: flex; gap: 18px; }
.footer-social a { color: var(--muted); }
.footer-social a:hover { color: var(--text); }
@media (max-width: 899px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
  .footer-bottom { flex-direction: column; gap: 14px; align-items: flex-start; }
}

/* ── Divider ── */
.divider { border: none; border-top: 1px solid var(--border); margin: 0; }
