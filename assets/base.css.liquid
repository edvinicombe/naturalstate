/* ================================================
   NATURAL STATE RUNNING GEAR — v2.0
   ================================================ */

:root {
  --bg:          {{ settings.color_background }};
  --surface:     {{ settings.color_surface }};
  --border:      {{ settings.color_border }};
  --text:        {{ settings.color_text }};
  --muted:       {{ settings.color_text_muted }};
  --accent:      {{ settings.color_accent }};
  --accent-text: {{ settings.color_accent_text }};
  --max-w:       {{ settings.page_width }}px;
  /* 8px spacing grid: --sp-N = N x 8px */
  --sp-1:  0.5rem;  --sp-2:  1rem;    --sp-3:  1.5rem;  --sp-4:  2rem;
  --sp-5:  2.5rem;  --sp-6:  3rem;    --sp-7:  3.5rem;  --sp-8:  4rem;
  --sp-9:  4.5rem;  --sp-10: 5rem;    --sp-11: 5.5rem;  --sp-12: 6rem;
  --sp-15: 7.5rem;
  --gap:         var(--sp-3);
  --section-gap: var(--sp-10);   /* space between sections: 80px, 64px on phones */
  --header-h:    calc({{ settings.logo_height }}rem + var(--sp-6));
  --font-body:    {% if settings.font_body.family != blank %}{{ settings.font_body.family }},{% endif %} -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-heading: {% if settings.font_heading.family != blank %}{{ settings.font_heading.family }},{% endif %} -apple-system, "Helvetica Neue", Arial, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
}

img { display: block; max-width: 100%; }
a   { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }
/* Browser defaults derive from font size (e.g. 14.4px); pin them to the grid. */
p { margin-block: var(--sp-2); }
input[type="radio"], input[type="checkbox"] { margin: 0; }

/* ── Layout ── */
.page-width {
  max-width: var(--max-w);
  margin: 0 auto;
  padding-inline: var(--sp-5);
}
@media (max-width: 749px) { .page-width { padding-inline: var(--sp-3); } }

.section-pad        { padding-block: var(--section-gap); }
.section-pad--sm    { padding-block: var(--sp-8); }
/* A section that follows another drops its own top padding, so gaps never double. */
.section-pad + .section-pad,
main .shopify-section + .shopify-section > .section-pad:first-child { padding-top: 0; }
@media (max-width: 749px) {
  :root { --section-gap: var(--sp-8); }
  .section-pad--sm { padding-block: var(--sp-5); }
}

/* ── Type ── */
h1,h2,h3,h4,h5 {
  font-family: var(--font-heading);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 1.0;
  margin: 0;
}
.h1 { font-size: clamp(2rem, 4.5vw, 3.6rem); }
.h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
.h3 { font-size: clamp(1.2rem, 2vw, 1.6rem); }

.eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 600;
  margin: 0;
}

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  min-height: var(--sp-6);
  padding: var(--sp-1) var(--sp-4);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 999px;
  border: 1.5px solid var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  transition: opacity 0.18s, transform 0.18s;
  white-space: nowrap;
  font-family: var(--font-body);
}
.btn:hover  { opacity: 0.82; }
.btn:active { transform: scale(0.97); }
.btn--ghost {
  background: transparent;
  color: var(--text);
  border-color: var(--border);
}
.btn--ghost:hover { border-color: var(--text); opacity: 1; }
.btn--full  { width: 100%; }
.btn--lg    { min-height: var(--sp-7); padding: var(--sp-1) var(--sp-5); font-size: 0.88rem; }
.btn:disabled { opacity: 0.38; cursor: not-allowed; }
@media (max-width: 479px) {
  .btn { max-width: 100%; white-space: normal; text-align: center; }
  .btn--lg { padding-inline: var(--sp-3); }
}

/* ── Announcement bar ── */
.announcement-bar {
  background: var(--text);
  color: var(--bg);
  text-align: center;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--sp-5);
  padding: 0 var(--sp-2);
}

/* ── Header ── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(var(--sp-2));
  -webkit-backdrop-filter: blur(var(--sp-2));
  border-bottom: 1px solid var(--border);
}
.site-header--transparent {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-bottom: none;
}
.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--header-h);
  padding-block: var(--sp-3);
  gap: var(--sp-3);
}
.site-header__logo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.site-header__logo img { height: {{ settings.logo_height }}rem; width: auto; }

.site-nav {
  display: flex;
  gap: var(--sp-4);
  list-style: none;
  margin: 0;
  padding: 0;
}
.site-nav a {
  font-size: 0.78rem;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--text);
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: var(--sp-5);
}
.site-nav a::after {
  content: "";
  position: absolute;
  left: 0; bottom: var(--sp-1);
  width: 0; height: 1px;
  background: var(--text);
  transition: width 0.22s ease;
}
.site-nav a:hover::after { width: 100%; }

.header-icons {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.header-icons a,
.header-icons button {
  background: none;
  border: none;
  color: var(--text);
  display: flex;
  align-items: center;
  position: relative;
  padding: 0;
}
.header-icons a::before,
.header-icons button::before {
  content: "";
  position: absolute;
  inset: calc(-1 * var(--sp-1));
}
/* Saved hearts fill solid once saved */
.icon-heart__fill { display: none; }
[data-save].active .icon-heart__fill { display: inline; }

.cart-count[hidden] { display: none; }
.cart-count {
  position: absolute;
  top: calc(-1 * var(--sp-1)); right: calc(-1 * var(--sp-1));
  background: var(--text);
  color: var(--bg);
  font-size: 0.6rem;
  font-weight: 800;
  width: var(--sp-2); height: var(--sp-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 1199px) { .site-nav { gap: var(--sp-3); } }
@media (max-width: 999px)  { .site-nav { gap: var(--sp-2); } }
@media (max-width: 749px) {
  .header-icons { gap: var(--sp-2); }
  .site-header__inner { gap: var(--sp-2); }
}
@media (max-width: 359px) {
  .header-icons a[aria-label="Account"] { display: none; }
}
.mobile-toggle { display: none; position: relative; padding: 0; line-height: 0; background: none; border: none; color: var(--text); }
.mobile-toggle::before { content: ""; position: absolute; inset: calc(-1 * var(--sp-1)); }
@media (max-width: 899px) {
  .site-nav     { display: none; }
  .mobile-toggle { display: block; }
  .site-header__inner { position: relative; }
  .site-header__logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
}

/* Mobile drawer */
.mobile-drawer {
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 200;
  padding: var(--sp-3) var(--sp-4);
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(.4,0,.2,1);
  overflow-y: auto;
}
.mobile-drawer.open { transform: translateX(0); }
.mobile-drawer__close {
  background: none;
  border: none;
  color: var(--text);
  margin-bottom: var(--sp-4);
  display: block;
  padding: var(--sp-1);
  margin-left: calc(-1 * var(--sp-1));
}
.mobile-drawer nav {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.mobile-drawer nav a,
.mobile-drawer nav button {
  font-size: 1.5rem;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: -0.01em;
  background: none;
  border: none;
  color: var(--text);
  text-align: left;
  padding: 0;
}

/* ── Saved drawer ── */
.saved-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 440px;
  background: var(--bg);
  border-left: 1px solid var(--border);
  z-index: 300;
  padding: var(--sp-4) var(--sp-3);
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(.4,0,.2,1);
  overflow-y: auto;
}
.saved-drawer.open { transform: translateX(0); }
.saved-drawer__close {
  background: none;
  border: none;
  color: var(--text);
  margin-bottom: var(--sp-3);
  display: block;
  padding: var(--sp-1);
  margin-left: calc(-1 * var(--sp-1));
}
.saved-drawer__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}
@media (max-width: 480px) {
  .saved-drawer { max-width: 100%; }
}

/* ── Hero ── */
.hero {
  position: relative;
  min-height: 90vh;
  margin-top: calc(-1 * var(--header-h));
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: var(--surface);
}
.hero__bg {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(255,255,255,0.55) 0%, rgba(0,0,0,0) 18%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.78) 100%);
  z-index: 1;
}
.hero__content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding-bottom: var(--sp-9);
}
.hero__content { text-align: center; }
.hero__content .eyebrow { color: rgba(245,243,239,0.7); margin-bottom: 16px; }
.hero__content h1 { color: #f5f3ef; margin-bottom: var(--sp-4); max-width: 34ch; margin-inline: auto; }
.hero__actions { display: flex; gap: var(--sp-2); flex-wrap: wrap; justify-content: center; }
@media (max-width: 749px) {
  .hero { min-height: 75vh; }
  .hero__content { padding-bottom: var(--sp-6); }
}

/* ── Section header ── */
.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--sp-5);
  gap: var(--sp-3);
}

/* ── Product grid ── */
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap);
}
.product-grid--3 { grid-template-columns: repeat(3, 1fr); }
.section-header__eyebrow { margin-bottom: var(--sp-1); }
.product-card__media--empty { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.8rem; }
@media (max-width: 1100px) { .product-grid { grid-template-columns: repeat(3,1fr); } }
@media (max-width: 749px)  { .product-grid { grid-template-columns: repeat(2,1fr); gap: var(--sp-2); } }

/* ── Product card ── */
.product-card { display: block; position: relative; }
.product-card__media-link { display: block; height: 100%; }
.product-card__info { display: block; }
.product-card__media {
  position: relative;
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: var(--sp-2);
}
.product-card__media img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.55s ease, opacity 0.35s ease;
}
.product-card__media .img-secondary {
  position: absolute; inset: 0;
  opacity: 0;
}
.product-card:hover .img-primary   { opacity: 0; }
.product-card:hover .img-secondary { opacity: 1; }
.product-card:hover .img-primary:only-child { opacity: 1; transform: scale(1.04); }

.product-card__badge {
  position: absolute;
  top: var(--sp-2); left: var(--sp-2);
  background: var(--accent);
  color: var(--accent-text);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  height: var(--sp-3);
  padding: 0 var(--sp-1);
  border-radius: 999px;
  z-index: 1;
}

.product-card__title {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  margin: 0 0 var(--sp-1);
}
.product-card__price {
  margin: 0;
  font-size: 0.88rem;
  color: var(--muted);
}
.product-card__price s { margin-right: var(--sp-1); opacity: 0.6; }
/* Quick save + quick add on product cards */
.card-save {
  position: absolute;
  top: var(--sp-2);
  right: var(--sp-2);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--sp-5);
  height: var(--sp-5);
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: rgba(255,255,255,0.92);
  color: var(--text);
}
.card-save:hover { background: #fff; }

.quick-add { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
.quick-add > * { pointer-events: auto; }
.quick-add__btn {
  position: absolute;
  left: var(--sp-2);
  right: var(--sp-2);
  bottom: var(--sp-2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  min-height: var(--sp-5);
  padding: 0 var(--sp-2);
  border: 0;
  border-radius: 999px;
  background: rgba(255,255,255,0.95);
  color: var(--text);
  font: inherit;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.quick-add__btn:hover { background: #fff; }
.quick-add__btn:disabled { opacity: 0.6; cursor: default; }
.quick-add__icon { flex-shrink: 0; }
.quick-add__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: var(--sp-2);
  max-height: 100%;
  overflow-y: auto;
  background: var(--bg);
  transform: translateY(100%);
  visibility: hidden;
  transition: transform 0.25s ease, visibility 0s linear 0.25s;
}
.product-card.is-picking .quick-add__panel { transform: none; visibility: visible; transition-delay: 0s; }
.quick-add__panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-1);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}
.quick-add__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--sp-3);
  height: var(--sp-3);
  padding: 0;
  border: 0;
  background: none;
  color: var(--text);
}
.quick-add__sizes { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--sp-4), 1fr)); gap: var(--sp-1); }
.quick-add__size {
  height: var(--sp-4);
  padding: 0;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text);
  font: inherit;
  font-size: 0.8rem;
}
.quick-add__size:hover:not(:disabled) { border-color: var(--text); }
.quick-add__size:disabled { opacity: 0.35; text-decoration: line-through; cursor: not-allowed; }

@media (hover: hover) {
  .quick-add { opacity: 0; transform: translateY(var(--sp-1)); transition: opacity 0.2s ease, transform 0.2s ease; }
  .product-card:hover .quick-add,
  .product-card:focus-within .quick-add,
  .product-card.is-picking .quick-add,
  .quick-add.is-busy { opacity: 1; transform: none; }
}
@media (hover: none) {
  .quick-add__btn { left: auto; width: var(--sp-5); padding: 0; }
  .quick-add__label { display: none; }
}
.saved-remove {
  display: block;
  margin-top: 8px;
  background: none;
  border: none;
  padding: 0;
  font-size: 0.75rem;
  color: var(--muted);
  text-decoration: underline;
  cursor: pointer;
}
.saved-remove:hover { color: var(--text); }

/* ── Story / Image+text block ── */
.story-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-8);
  align-items: center;
}
.story-block.reversed > *:first-child { order: 2; }
.story-block + .story-block,
.story-block + .stat-strip,
.page-width + .newsletter-block { margin-top: var(--section-gap); }
.story-block__img {
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
}
.story-block__img img { width: 100%; height: 100%; object-fit: cover; }
.story-block__text .eyebrow { margin-bottom: var(--sp-2); }
.story-block__text h2 { margin-bottom: var(--sp-3); }
.story-block__text p {
  color: var(--muted);
  line-height: var(--sp-3);
  margin-bottom: var(--sp-2);
}
@media (max-width: 849px) {
  .story-block, .story-block.reversed { grid-template-columns: 1fr; }
  .story-block.reversed > *:first-child { order: 0; }
}

/* ── Our mission (homepage) ── */
.mission { --rail-pad: max(var(--sp-5), calc((100vw - var(--max-w)) / 2 + var(--sp-5))); overflow: hidden; }
.mission__head {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: var(--sp-3);
  row-gap: var(--sp-3);
  align-items: end;
  margin-bottom: var(--sp-8);
}
.mission__eyebrow { grid-column: 1 / -1; margin-bottom: calc(-1 * var(--sp-1)); }
.mission__heading { grid-column: 1 / -1; font-size: clamp(3rem, 12vw, 10rem); line-height: 0.88; letter-spacing: -0.04em; }
.mission__tagline { grid-column: 1 / 8; margin: 0; font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.15; font-weight: 600; }
.mission__aside { grid-column: 9 / 13; }
.mission__aside p { margin: 0 0 var(--sp-3); color: var(--muted); line-height: var(--sp-3); }
.mission__aside .btn { gap: var(--sp-1); }
.mission__aside .btn svg { flex-shrink: 0; margin-right: calc(-1 * var(--sp-1)); }

.mission__rail {
  display: flex;
  gap: var(--sp-2);
  margin: 0;
  padding: 0 var(--rail-pad);
  list-style: none;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: var(--rail-pad);
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.mission__rail::-webkit-scrollbar { display: none; }
.mission__rail:focus-visible { outline: 2px solid var(--text); outline-offset: -2px; }
.mission-tile {
  position: relative;
  flex: 0 0 clamp(16rem, 28vw, 24rem);
  aspect-ratio: 3 / 4;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--sp-3);
  overflow: hidden;
  scroll-snap-align: start;
  background: var(--tile-bg, #141414);
  color: #fff;
}
.mission-tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
.mission-tile:hover .mission-tile__img { transform: scale(1.05); }
.mission-tile--image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0) 60%); }
.mission-tile__num { position: absolute; top: var(--sp-3); left: var(--sp-3); z-index: 1; font-size: 0.72rem; letter-spacing: 0.2em; font-weight: 600; opacity: 0.8; }
.mission-tile__body { position: relative; z-index: 1; }
.mission-tile__title { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1; margin-bottom: var(--sp-1); }
.mission-tile__text { margin: 0; font-size: 0.88rem; line-height: var(--sp-3); opacity: 0.85; max-width: 28ch; }

.mission__controls { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); margin-top: var(--sp-4); }
.mission__progress { flex: 1; height: 2px; background: var(--border); }
.mission__progress span { display: block; height: 100%; width: 0; background: var(--text); transition: width 0.2s ease; }
.mission__arrows { display: flex; gap: var(--sp-1); }
.rail-btn {
  display: flex; align-items: center; justify-content: center;
  width: var(--sp-6); height: var(--sp-6);
  border: 1px solid var(--border); border-radius: 999px;
  background: var(--bg); color: var(--text);
  transition: border-color 0.2s ease, opacity 0.2s ease;
}
.rail-btn:hover { border-color: var(--text); }
.rail-btn:disabled { opacity: 0.35; cursor: default; }
.rail-btn:disabled:hover { border-color: var(--border); }
@media (max-width: 899px) {
  .mission__tagline, .mission__aside { grid-column: 1 / -1; }
  .mission__head { margin-bottom: var(--sp-5); }
}
@media (max-width: 749px) {
  .mission { --rail-pad: var(--sp-3); }
  .mission__controls { gap: var(--sp-3); }
}

/* ── Quality showcase (homepage) ── */
.quality__head { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--sp-3); row-gap: var(--sp-2); align-items: end; margin-bottom: var(--sp-5); }
.quality__head > div { grid-column: 1 / 8; }
.quality__heading { margin-top: var(--sp-1); font-size: clamp(2.5rem, 6vw, 5rem); line-height: 0.92; }
.quality__intro { grid-column: 9 / 13; margin: 0; color: var(--muted); line-height: var(--sp-3); }

.quality__stage { position: relative; aspect-ratio: 16 / 9; background: var(--surface); overflow: hidden; }
.quality__stage > img { width: 100%; height: 100%; object-fit: cover; }
.hotspot { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); z-index: 1; }
.hotspot:hover, .hotspot:focus-within, .hotspot.is-open { z-index: 3; }
.hotspot__dot {
  position: relative; display: block;
  width: var(--sp-5); height: var(--sp-5); padding: 0;
  border: 0; border-radius: 999px; background: rgba(255,255,255,0.35);
  backdrop-filter: blur(4px);
}
.hotspot__dot span { position: absolute; inset: var(--sp-1); border-radius: 999px; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,0.7); animation: hotspot-pulse 2.4s ease-out infinite; transition: transform 0.2s ease; }
.hotspot__dot:hover span, .hotspot.is-open .hotspot__dot span { transform: scale(0.75); animation: none; }
.hotspot__dot:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
@keyframes hotspot-pulse { 70% { box-shadow: 0 0 0 var(--sp-2) rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }
.hotspot__card {
  position: absolute; top: 50%; left: calc(100% + var(--sp-1));
  width: 17.5rem; padding: var(--sp-3);
  background: var(--bg); color: var(--text);
  opacity: 0; visibility: hidden; transform: translateY(-40%);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  pointer-events: none;
}
.hotspot--left .hotspot__card { left: auto; right: calc(100% + var(--sp-1)); }
.hotspot--up .hotspot__card { top: auto; bottom: 50%; transform: translateY(40%); }
.hotspot:hover .hotspot__card, .hotspot:focus-within .hotspot__card, .hotspot.is-open .hotspot__card { opacity: 1; visibility: visible; transform: translateY(-50%); pointer-events: auto; }
.hotspot--up:hover .hotspot__card, .hotspot--up:focus-within .hotspot__card, .hotspot--up.is-open .hotspot__card { transform: translateY(50%); }
.hotspot__card h3 { font-size: 1rem; margin-bottom: var(--sp-1); }
.hotspot__card p { margin: 0; font-size: 0.85rem; line-height: var(--sp-3); color: var(--muted); }

.quality__tiles { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(15rem, 22vw, 20rem); grid-auto-flow: dense; gap: var(--sp-2); margin-top: var(--sp-2); }
.quality-tile { position: relative; margin: 0; overflow: hidden; background: var(--surface); }
.quality-tile:nth-child(1) { grid-column: span 2; grid-row: span 2; }
.quality-tile:nth-child(4) { grid-column: span 2; }
.quality-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
.quality-tile:hover img { transform: scale(1.06); }
.quality-tile figcaption {
  position: absolute; inset: auto 0 0 0; padding: var(--sp-3);
  color: #fff; background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0));
  transition: padding 0.3s ease;
}
.quality-tile:hover figcaption { padding-bottom: var(--sp-4); }
.quality-tile figcaption h3 { font-size: 1.1rem; }
.quality-tile figcaption p { margin: var(--sp-1) 0 0; font-size: 0.85rem; line-height: var(--sp-3); opacity: 0.88; max-width: 36ch; }
.quality-tile:not(:has(img)) figcaption { position: static; color: var(--text); background: none; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }

.quality__proof { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--sp-4); margin: var(--sp-5) 0 0; padding: var(--sp-5) 0 0; list-style: none; border-top: 1px solid var(--border); }
.quality__proof li { display: flex; flex-direction: column; gap: var(--sp-1); }
.quality__proof-n { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
.quality__proof-l { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

@media (max-width: 899px) {
  .quality__head > div, .quality__intro { grid-column: 1 / -1; }
  .quality__tiles { grid-template-columns: repeat(2, 1fr); }
  .quality-tile:nth-child(4) { grid-column: auto; }
}
@media (max-width: 749px) {
  .quality__stage { aspect-ratio: 4 / 5; }
  /* Phones: dots stay on the image, the card opens as a panel along the bottom of it */
  .hotspot { position: static; transform: none; }
  .hotspot__dot { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); }
  .hotspot__card,
  .hotspot--left .hotspot__card,
  .hotspot--up .hotspot__card { top: auto; bottom: var(--sp-2); left: var(--sp-2); right: var(--sp-2); width: auto; padding: var(--sp-2); transform: translateY(var(--sp-1)); }
  .hotspot:hover .hotspot__card, .hotspot:focus-within .hotspot__card, .hotspot.is-open .hotspot__card,
  .hotspot--up:hover .hotspot__card, .hotspot--up:focus-within .hotspot__card, .hotspot--up.is-open .hotspot__card { transform: none; }
  .quality__tiles { grid-auto-rows: 14rem; gap: var(--sp-1); }
  .quality-tile:nth-child(1) { grid-column: 1 / -1; }
  .quality__proof { gap: var(--sp-3); }
}

/* ── Newsletter banner ── */
.newsletter-block {
  background: var(--surface);
  text-align: center;
  padding: var(--sp-11) var(--sp-5);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.newsletter-block h2 { margin-bottom: var(--sp-2); }
.newsletter-block p  { color: var(--muted); margin-bottom: var(--sp-4); max-width: 440px; margin-inline: auto; }
.newsletter-form {
  display: flex;
  gap: var(--sp-1);
  max-width: 400px;
  margin-inline: auto;
}
.newsletter-form input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 1.5px solid var(--border);
  color: var(--text);
  min-height: var(--sp-6);
  padding: 0 var(--sp-3);
  border-radius: 999px;
  font-size: 0.9rem;
  font-family: var(--font-body);
}
.newsletter-form input::placeholder { color: var(--muted); }
@media (max-width: 480px) { .newsletter-form { flex-direction: column; } }

/* ── Product page ── */
.product-layout {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: var(--sp-8);
  align-items: start;
  padding-block: var(--sp-6) var(--section-gap);
}
@media (max-width: 949px) { .product-layout { grid-template-columns: 1fr; gap: var(--sp-4); } }

.gallery__main {
  aspect-ratio: 4/5;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: var(--sp-1);
}
.gallery__main img { width: 100%; height: 100%; object-fit: cover; }
.gallery__thumbs {
  display: grid;
  grid-template-columns: repeat(5,1fr);
  gap: 8px;
}
.gallery__thumb {
  aspect-ratio: 1;
  background: var(--surface);
  overflow: hidden;
  border: 1.5px solid transparent;
  cursor: pointer;
}
.gallery__thumb.active { border-color: var(--text); }
.gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }

.product-details { padding-bottom: var(--section-gap); }
.product-info { position: sticky; top: 96px; }
@media (max-width: 949px) { .product-info { position: static; } }
.product-info__eyebrow { margin-bottom: var(--sp-1); }

.product-info__title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-2); margin-bottom: var(--sp-2); }
.product-info__title-row .product-info__title { margin-bottom: 0; }
.save-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  padding: var(--sp-1);
  margin: calc(-1 * var(--sp-1)) calc(-1 * var(--sp-1)) 0 0;
  color: var(--muted);
}
.save-btn:hover { color: var(--text); }
.save-btn.active { color: var(--text); }

.rating-summary {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  margin: calc(-1 * var(--sp-2)) 0 var(--sp-3);
  padding: 0;
  background: none;
  border: 0;
  font: inherit;
  font-size: 0.85rem;
  color: var(--muted);
  cursor: pointer;
}
.rating-summary:hover span:last-child { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
.rating-summary .stars__star { font-size: 0.95rem; }
.gender-switch { display: flex; gap: var(--sp-1); margin-bottom: var(--sp-3); }
.gender-switch__tab {
  display: inline-flex;
  align-items: center;
  min-height: var(--sp-5);
  padding: 0 var(--sp-2);
  border: 1px solid var(--border);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--muted);
}
.gender-switch__tab:hover { border-color: var(--muted); }
.gender-switch__tab.active { border-color: var(--text); color: var(--text); }
.gender-switch__tab.disabled { opacity: 0.35; cursor: not-allowed; }
.product-info__title { font-size: clamp(1.6rem,3vw,2.2rem); margin-bottom: var(--sp-2); max-width: 22ch; }
.product-info__price {
  font-size: 1.35rem;
  font-weight: 500;
  margin-bottom: var(--sp-4);
  display: flex;
  align-items: baseline;
  gap: var(--sp-1);
}
.product-info__price s { color: var(--muted); font-size: 1rem; font-weight: 400; }
.price-sale { color: #e07a6e; }

.product-info__desc {
  color: var(--muted);
  font-size: 0.93rem;
  line-height: var(--sp-3);
  margin-bottom: var(--sp-4);
  padding-bottom: var(--sp-4);
  border-bottom: 1px solid var(--border);
}

.option-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: var(--sp-1);
}
.option-label span { color: var(--muted); text-transform: none; letter-spacing: 0; font-weight: 400; }
.swatches { display: flex; flex-wrap: wrap; gap: var(--sp-1); margin-bottom: var(--sp-3); }
.swatch {
  min-width: var(--sp-6);
  height: var(--sp-6);
  padding: 0 var(--sp-2);
  border: 1.5px solid var(--border);
  border-radius: var(--sp-1);
  background: transparent;
  color: var(--text);
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s;
  cursor: pointer;
  font-family: var(--font-body);
}
.swatch:hover  { border-color: var(--muted); }
.swatch.active { border-color: var(--text); background: var(--text); color: var(--bg); }
.swatch.unavailable { opacity: 0.3; text-decoration: line-through; cursor: not-allowed; }

.product-actions { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-1); }

.accordion { margin-top: var(--sp-4); border-top: 1px solid var(--border); }
.accordion details { border-bottom: 1px solid var(--border); }
.accordion summary {
  list-style: none;
  cursor: pointer;
  min-height: var(--sp-7);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
}
.accordion summary::-webkit-details-marker { display: none; }
.accordion summary::after { content: "+"; font-size: 1.1rem; font-weight: 300; color: var(--muted); }
.accordion details[open] summary::after { content: "−"; }
.accordion .body {
  padding-bottom: var(--sp-3);
  color: var(--muted);
  font-size: 0.9rem;
  line-height: var(--sp-3);
}

/* ── Breadcrumb ── */
.breadcrumb {
  font-size: 0.78rem;
  color: var(--muted);
  margin-bottom: 24px;
}
.breadcrumb a:hover { color: var(--text); }

/* ── Cart ── */
.cart-wrap { padding-block: var(--sp-7) var(--section-gap); }
.cart-wrap h1 { margin-bottom: 48px; }
.cart-layout {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 56px;
  align-items: start;
}
@media (max-width: 899px) { .cart-layout { grid-template-columns: 1fr; } }
.cart-line {
  display: grid;
  grid-template-columns: 96px 1fr auto;
  gap: var(--sp-2);
  padding: var(--sp-3) 0;
  border-bottom: 1px solid var(--border);
}
.cart-line__img { aspect-ratio: 4/5; background: var(--surface); overflow: hidden; }
.cart-line__img img { width: 100%; height: 100%; object-fit: cover; }
.cart-line__title { font-size: 0.93rem; font-weight: 500; margin-bottom: var(--sp-1); }
.cart-line__variant { font-size: 0.8rem; color: var(--muted); margin-bottom: var(--sp-2); }
.qty {
  display: inline-flex;
  align-items: stretch;
  height: var(--sp-5);
  border: 1.5px solid var(--border);
  border-radius: 999px;
  overflow: hidden;
}
.qty button { background: none; border: none; color: var(--text); width: var(--sp-5); height: 100%; padding: 0; font-size: 1rem; }
.qty input {
  width: var(--sp-5); height: 100%; padding: 0; text-align: center;
  background: none; border: none;
  color: var(--text); font-size: 0.85rem;
  font-family: var(--font-body);
}
.cart-line__price { text-align: right; font-size: 0.95rem; }
.cart-line__remove {
  font-size: 0.73rem;
  color: var(--muted);
  text-decoration: underline;
  display: inline-block;
  margin-top: var(--sp-1);
}
.order-summary {
  background: var(--surface);
  border: 1px solid var(--border);
  padding: var(--sp-4);
  position: sticky;
  top: var(--sp-12);
  border-radius: var(--sp-1);
}
.order-summary h3 { font-size: 1rem; margin-bottom: var(--sp-3); }
.summary-row { display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: var(--sp-2); }
.summary-row.total {
  font-size: 1.05rem; font-weight: 700;
  padding-top: 16px; margin-top: 16px;
  border-top: 1px solid var(--border);
}
.cart-empty { text-align: center; padding: var(--sp-12) 0; color: var(--muted); }

/* ── Our Story ── */
.story-hero {
  text-align: center;
  padding: var(--section-gap) var(--sp-3) var(--sp-8);
  max-width: 704px;
  margin-inline: auto;
}
.story-hero .motto { max-width: min(384px, 100%); margin-inline: auto; margin-bottom: var(--sp-4); }
.story-hero p { color: var(--muted); font-size: 1.05rem; line-height: var(--sp-4); }

.stat-strip {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  text-align: center;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding-block: 56px;
  gap: 24px;
}
.stat-strip__n { font-size: clamp(1.8rem,3.5vw,2.8rem); font-family: var(--font-heading); margin-bottom: 8px; }
.stat-strip__l { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
@media (max-width: 749px) { .stat-strip { grid-template-columns: 1fr; gap: var(--sp-5); } }

/* ── Generic page ── */
.page-body { padding-block: var(--sp-8) var(--section-gap); max-width: 720px; }
.page-body h1 { margin-bottom: 32px; }
.page-body div { color: var(--muted); line-height: var(--sp-3); }

/* ── Search ── */
.search-form { display: flex; gap: var(--sp-1); max-width: 480px; margin-bottom: var(--sp-7); }
.search-form input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 1.5px solid var(--border);
  color: var(--text);
  min-height: var(--sp-6);
  padding: 0 var(--sp-3);
  border-radius: 999px;
  font-size: 0.9rem;
  font-family: var(--font-body);
}
.search-form input::placeholder { color: var(--muted); }

/* ── 404 / empty states ── */
.empty-state {
  text-align: center;
  padding: var(--sp-15) var(--sp-3);
  color: var(--muted);
}
.empty-state h1 { color: var(--text); margin-bottom: var(--sp-2); }
.empty-state p  { margin-bottom: var(--sp-4); }

/* ── Reviews ── */
.visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  margin: -1px; padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.stars { display: inline-flex; gap: 0; line-height: 1; }
.stars__star { color: var(--border); font-size: 1rem; }
.stars__star.is-on { color: var(--text); }

.reviews { padding-bottom: var(--section-gap); }
.reviews__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-bottom: var(--sp-5);
}
.reviews__summary { display: flex; align-items: center; gap: var(--sp-2); margin-top: var(--sp-2); font-size: 0.88rem; color: var(--muted); }
.reviews__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-5) var(--sp-7); margin-bottom: 0; }
.review { border-top: 1px solid var(--border); padding-top: var(--sp-3); }
.review__title { font-size: 1rem; text-transform: none; letter-spacing: 0; margin: var(--sp-2) 0 var(--sp-1); line-height: var(--sp-3); }
.review__body { color: var(--muted); font-size: 0.92rem; line-height: var(--sp-3); margin: 0 0 var(--sp-2); }
.review__meta { font-size: 0.78rem; color: var(--muted); margin: 0; }
.reviews__empty {
  text-align: center;
  padding: var(--sp-5) var(--sp-3);
  margin-bottom: calc(-1 * var(--sp-5));
}
.reviews__empty-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 8px; }
.reviews__empty p:nth-of-type(2) { color: var(--muted); margin: 0; }

.review-form__fields { display: grid; gap: var(--sp-3); }
.review-form__field { display: grid; gap: var(--sp-1); font-size: 0.82rem; font-weight: 600; }
.review-form__field em { font-style: normal; font-weight: 400; color: var(--muted); }
.review-form__field input,
.review-form__field select,
.review-form__field textarea {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
  font: inherit;
  font-weight: 400;
  min-height: var(--sp-6);
  padding: 0 var(--sp-2);
  border-radius: 0;
}
.review-form__field textarea { padding: var(--sp-2); }
.review-form__field input:focus,
.review-form__field select:focus,
.review-form__field textarea:focus { outline: none; border-color: var(--text); }
.review-form__hint { font-size: 0.78rem; color: var(--muted); line-height: var(--sp-3); margin: 0; }
.review__badges { display: flex; flex-wrap: wrap; gap: var(--sp-1); margin: var(--sp-2) 0 0; }
.review__badge { display: inline-flex; align-items: center; height: var(--sp-3); font-size: 0.7rem; letter-spacing: 0.04em; border: 1px solid var(--border); padding: 0 var(--sp-1); color: var(--muted); }
.reviews__empty .btn { margin-top: var(--sp-3); }

/* Review side panel */
html.no-scroll { overflow: hidden; }
.review-panel {
  position: fixed;
  inset: 0;
  z-index: 400;
  visibility: hidden;
  transition: visibility 0s linear 0.3s;
}
.review-panel.is-open { visibility: visible; transition-delay: 0s; }
.review-panel__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.review-panel.is-open .review-panel__overlay { opacity: 1; }
.review-panel__sheet {
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 100%;
  max-width: 480px;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(.4,0,.2,1);
}
.review-panel.is-open .review-panel__sheet { transform: translateX(0); }
.review-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--sp-9);
  padding: 0 var(--sp-4);
  border-bottom: 1px solid var(--border);
}
.review-panel__title { font-size: 1.1rem; text-transform: none; letter-spacing: 0; }
.review-panel__close { background: none; border: none; color: var(--text); padding: var(--sp-1); margin-right: calc(-1 * var(--sp-1)); display: flex; }
.review-panel__body { flex: 1; overflow-y: auto; padding: var(--sp-4); }
.review-panel__product { display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-4); }
.review-panel__product img { width: var(--sp-8); height: var(--sp-10); object-fit: cover; background: var(--surface); }
.review-panel__product p { margin: 0; font-weight: 600; font-size: 0.95rem; }
@media (max-width: 520px) {
  .review-panel__head, .review-panel__body { padding-inline: var(--sp-3); }
}
.review-form__notice { padding: var(--sp-2); margin: 0 0 var(--sp-3); font-size: 0.9rem; }
.review-form__notice--success { background: var(--surface); }
.review-form__notice--error { border: 1px solid var(--border); }
.review-form__notice ul { margin: 0; padding-left: var(--sp-3); }

.star-input { border: 0; padding: 0; margin: 0; }
.star-input legend { font-size: 0.82rem; font-weight: 600; padding: 0; margin-bottom: var(--sp-1); }
.star-input__stars { position: relative; display: inline-flex; flex-direction: row-reverse; gap: var(--sp-1); }
.star-input input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.star-input label { font-size: 2rem; line-height: 1; color: var(--border); cursor: pointer; }
.star-input input:checked ~ label,
.star-input label:hover,
.star-input label:hover ~ label { color: var(--text); }
.star-input input:focus-visible + label { outline: 2px solid var(--text); outline-offset: 2px; }

@media (max-width: 899px) {
  .reviews__head { flex-direction: column; align-items: flex-start; }
  .reviews__list { grid-template-columns: 1fr; }
}

/* ── Reassurance strip ── */
.reassurance { background: #fafafa; padding-block: var(--sp-7); }
.reassurance__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px;
}
.reassurance__item { display: flex; align-items: flex-start; gap: var(--sp-2); }
.reassurance__icon { flex-shrink: 0; display: flex; color: var(--text); }
.reassurance__title { font-size: 1rem; font-weight: 700; text-transform: none; letter-spacing: 0; margin: 0 0 var(--sp-1); line-height: var(--sp-3); }
.reassurance__text { color: var(--muted); font-size: 0.88rem; line-height: var(--sp-3); margin: 0 0 var(--sp-2); max-width: 42ch; }
.reassurance__link { font-size: 0.82rem; text-decoration: underline; text-underline-offset: 3px; }
.reassurance__link:hover { opacity: 0.7; }
@media (max-width: 899px) {
  .reassurance { padding-block: var(--sp-5); }
  .reassurance__grid { gap: var(--sp-4); }
}
@media (max-width: 639px) {
  .reassurance__grid { grid-template-columns: 1fr; gap: var(--sp-4); }
}

/* ── Footer ── */
.site-footer { border-top: 1px solid var(--border); }

.footer-newsletter-band { padding-block: var(--sp-9); }
.footer-newsletter-band__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-6);
  align-items: center;
}
.footer-newsletter-band__copy h2 { margin-bottom: var(--sp-2); }
.footer-newsletter-band__copy p { color: var(--muted); max-width: 36ch; margin: 0; line-height: var(--sp-3); }
.footer-newsletter-band .newsletter-form { margin-inline: 0; max-width: 480px; }
.footer-newsletter__legal { font-size: 0.75rem; color: var(--muted); margin-top: var(--sp-2); max-width: 480px; line-height: var(--sp-2); }
.footer-newsletter__legal p { margin: 0; }
.footer-newsletter__legal a { text-decoration: underline; text-underline-offset: 2px; color: var(--text); }
.footer-newsletter__success { font-weight: 600; margin: 0; }
.footer-newsletter__error { font-size: 0.85rem; margin-bottom: var(--sp-2); }
.footer-newsletter__error ul { margin: 0; padding-left: var(--sp-3); }

/* Main footer: colours come from the footer section settings; the theme
   variables are re-pointed here so every child picks them up. */
.footer-main {
  --bg: var(--footer-bg, #000);
  --text: var(--footer-text, #fff);
  --muted: #a1a1a1;
  --border: #2b2b2b;
  --surface: #151515;
  background: var(--footer-bg, #000);
  color: var(--footer-text, #fff);
  padding-block: var(--sp-8) var(--sp-4);
}
@supports (color: color-mix(in srgb, red, blue)) {
  .footer-main {
    --muted: color-mix(in srgb, var(--footer-text, #fff) 62%, var(--footer-bg, #000));
    --border: color-mix(in srgb, var(--footer-text, #fff) 18%, var(--footer-bg, #000));
  }
}

.footer-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-5) var(--sp-7);
  margin-bottom: var(--sp-7);
}
.footer-col { flex: 1 1 160px; min-width: 0; }
.footer-brand { flex: 2 1 280px; }
.footer-localization { flex: 1 1 224px; }
.footer-col h4 {
  font-size: 0.7rem;
  letter-spacing: 0.16em;
  color: var(--muted);
  margin-bottom: var(--sp-2);
}
.footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-1); }
.footer-col a { font-size: 0.88rem; line-height: var(--sp-3); color: var(--text); opacity: 0.8; overflow-wrap: anywhere; }
.footer-col a:hover { opacity: 1; }
.footer-brand img { width: 100%; height: auto; max-width: {{ settings.footer_logo_width }}rem; margin-bottom: var(--sp-2); }
.footer-brand img.footer-logo--white { filter: brightness(0) invert(1); }
.footer-brand p { color: var(--muted); font-size: 0.85rem; max-width: 34ch; line-height: var(--sp-3); margin: 0; }

.footer-localization__field { position: relative; max-width: 280px; }
.footer-localization select {
  width: 100%;
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--border);
  font: inherit;
  font-size: 0.85rem;
  min-height: var(--sp-6);
  padding: 0 var(--sp-2);
  border-radius: 0;
  text-overflow: ellipsis;
}
.footer-localization select:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
.footer-localization select option { background: var(--bg); color: var(--text); }
.footer-localization__static { display: flex; align-items: center; gap: var(--sp-1); margin: 0; font-size: 0.88rem; }
.footer-localization__note { margin: var(--sp-1) 0 0; font-size: 0.75rem; line-height: var(--sp-2); color: var(--muted); max-width: 280px; }

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-2) var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1px solid var(--border);
  font-size: 0.73rem;
  color: var(--muted);
}
.footer-social { display: flex; align-items: center; gap: var(--sp-3); margin-top: var(--sp-3); }
.footer-social a { display: flex; color: var(--text); opacity: 0.75; }
.footer-social a:hover { opacity: 1; }
.footer-payments { display: flex; align-items: center; gap: var(--sp-1); flex-wrap: wrap; justify-content: flex-end; margin-left: auto; }
.footer-payments__icon { height: var(--sp-3); width: auto; }
.footer-legal { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-1) var(--sp-3); justify-content: flex-start; }

@media (max-width: 1099px) {
  .footer-brand { flex: 1 1 100%; }
}
@media (max-width: 899px) {
  .footer-newsletter-band { padding-block: var(--sp-6); }
  .footer-newsletter-band__inner { grid-template-columns: 1fr; gap: var(--sp-4); }
  .footer-main { padding-block: var(--sp-6) var(--sp-4); }
  .footer-grid { gap: var(--sp-4); margin-bottom: var(--sp-5); }
  .footer-col { flex-basis: 144px; }
  .footer-brand { flex-basis: 100%; }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
  .footer-payments { justify-content: flex-start; margin-left: 0; }
}
@media (max-width: 599px) {
  .footer-localization { flex-basis: 100%; }
}
@media (max-width: 479px) {
  .footer-newsletter-band .newsletter-form { max-width: none; }
}

/* Cart: shipping destination note */
.cart-shipto { margin: var(--sp-2) 0 0; font-size: 0.8rem; line-height: var(--sp-3); color: var(--muted); text-align: center; }
