[
  {
    "name": "theme_info",
    "theme_name": "Natural State Running Gear",
    "theme_version": "2.0.0",
    "theme_author": "Custom Build",
    "theme_documentation_url": "https://github.com/edvinicombe/naturalstate",
    "theme_support_url": "https://github.com/edvinicombe/naturalstate/issues"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Header logo height",
        "min": 2,
        "max": 7,
        "step": 0.1,
        "unit": "rem",
        "default": 2.5
      },
      {
        "type": "range",
        "id": "footer_logo_width",
        "label": "Footer logo width",
        "min": 4,
        "max": 20,
        "step": 0.5,
        "unit": "rem",
        "default": 9
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / card",
        "default": "#f4f3f0"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#e0ddd6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary text",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#6e6e6e"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons)",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "assistant_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Max page width",
        "min": 1200,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1480
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Paste a profile link to show its icon in the footer. Leave a field empty to hide that icon."
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram link",
        "info": "e.g. https://instagram.com/yourhandle"
      },
      {
        "type": "url",
        "id": "social_strava",
        "label": "Strava link",
        "info": "e.g. https://www.strava.com/clubs/yourclub"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok link",
        "info": "e.g. https://www.tiktok.com/@yourhandle"
      }
    ]
  }
]
