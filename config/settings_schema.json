        "default": "#f4f3f0"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#e0ddd6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary text",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_text_muted",
